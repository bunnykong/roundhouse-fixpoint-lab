+    /// Deterministic digest of returns and parameter rows (privacy-safe).
+    pub(super) fn sccq_signature_digest(&self) -> u64 {
+        let mut entries: Vec<(String, u64)> = Vec::new();
+        for (id, c) in &self.classes {
+            for (side, table) in [("i", &c.instance_methods), ("c", &c.class_methods)] {
+                for (n, t) in table {
+                    let mut h = hasher();
+                    hash_ty(t, &mut h);
+                    if std::env::var("RH_SCCQ_DUMP_SIG").is_ok_and(|v| v == "2") {
+                        // Public inputs only.
+                        /* Input-bearing debug probe omitted. */
+                    }
+                    entries.push((format!("{}#{side}#{}", id.0.as_str(), n.as_str()), h.finish()));
+                }
+            }
+            let mut bv: Vec<&Symbol> = c.block_value_methods.iter().collect();
+            bv.sort_by(|a, b| a.as_str().cmp(b.as_str()));
+            for n in bv {
+                entries.push((format!("{}#b#{}", id.0.as_str(), n.as_str()), 1));
+            }
+        }
+        for ((c, m), row) in &self.inferred_params {
+            let mut h = hasher();
+            for t in row {
+                hash_ty(t, &mut h);
+            }
+            if std::env::var("RH_SCCQ_DUMP_SIG").is_ok_and(|v| v == "2") {
+                /* Input-bearing debug probe omitted. */
+            }
+            entries.push((format!("{}#p#{}", c.0.as_str(), m.as_str()), h.finish()));
+        }
+        entries.sort();
+        if std::env::var("RH_SCCQ_DUMP_SIG").is_ok_and(|v| v == "1") {
+            // Public inputs only: names and per-entry type hashes.
+            for (k, v) in &entries {
+                /* Input-bearing debug probe omitted. */
+            }
+        }
+        let mut h = hasher();
+        entries.hash(&mut h);
+        h.finish()
+    }
+
+    pub(super) fn sccq_print_stats(&self, arm_rounds: &str) {
+        if !stats_on() {
