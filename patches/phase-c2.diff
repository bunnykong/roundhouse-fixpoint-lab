+                shown.insert((1, cid.clone(), m.clone(), false), short(&format!("{row:?}")));
+            }
+        }
+        rows.sort_by(|a, b| (a.0, a.1 .0.as_str(), a.2.as_str(), a.3).cmp(&(b.0, b.1 .0.as_str(), b.2.as_str(), b.3)));
