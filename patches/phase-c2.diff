+    pub(super) fn sccq_model_unit(&self, ci: usize, mi: usize, scope: bool) -> Option<u32> {
+        self.sccq.as_ref().and_then(|e| {
+            let v = if scope { &e.model_scope_units } else { &e.model_method_units };
+            v.get(ci).and_then(|v| v.get(mi)).copied()
+        })
+    }
