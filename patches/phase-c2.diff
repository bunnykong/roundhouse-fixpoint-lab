+        let id = ClassId(Symbol::from(name.as_str()));
+        if let Some(c) = self.classes.get(&id) {
+            let mut v: Vec<_> = c.instance_methods.iter().collect();
+            v.sort_by(|a, b| a.0.as_str().cmp(b.0.as_str()));
