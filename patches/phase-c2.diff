+        // fourth unify pass (reference mode only grows; a late SCC is
+        // picked up at the next rebuild). The probes need a fresh graph
+        // every pass; `RH_FOLD_SLOTS_EVERY=1` forces it too.
+        let skip = ST.with(|s| {
+            let mut s = s.borrow_mut();
