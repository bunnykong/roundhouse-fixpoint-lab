+            self.fold_rho_sizes();
+        }
+        if *GROW && fold::on() {
+            self.fold_grow_trigger(app);
+        }
+        if !*RESIDUE {
+            return;
+        }
+        let mut rows: Vec<(u8, ClassId, Symbol, bool, u64)> = Vec::new();
+        let verbose = std::env::var("RH_FOLD_NAMES").is_ok_and(|s| s == "2");
+        let mut shown: HashMap<(u8, ClassId, Symbol, bool), String> = HashMap::new();
