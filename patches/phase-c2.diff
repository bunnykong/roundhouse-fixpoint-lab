+                for (m, t) in table {
+                    if matches!(t, Ty::Fn { .. }) {
+                        continue;
+                    }
+                    rows.push((0, cid.clone(), m.clone(), side, fp(t)));
+                    if verbose {
+                        shown.insert((0, cid.clone(), m.clone(), side), short(&format!("{t:?}")));
+                    }
+                }
+            }
+        }
+        for ((cid, m), row) in &self.inferred_params {
+            let mut h = std::collections::hash_map::DefaultHasher::new();
+            for t in row {
