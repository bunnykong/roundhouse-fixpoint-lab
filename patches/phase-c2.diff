+            for d in m.methods() {
+                defs.insert((&m.name, &d.name));
+            }
+        }
+        for lc in &app.library_classes {
+            for d in &lc.methods {
+                defs.insert((&lc.name, &d.name));
+            }
+        }
+        for c in &app.controllers {
+            for a in c.actions() {
