+                return None;
+            }
+            Some(Ty::Hash {
+                key: std::sync::Arc::new(k.unwrap_or_else(|| (**key).clone())),
+                value: std::sync::Arc::new(v.unwrap_or_else(|| (**value).clone())),
+            })
+        }
