+
+/// prototype (experiment): `RH_HASHSEED=<seed>`, or `RH_SHUFFLE=<seed>`, makes
+/// std's hash keys, and with them every HashMap's iteration order, a
+/// function of the seed. std draws the keys from `CCRandomGenerateBytes`,
+/// which this definition shadows inside the binary; each thread's draws are
+/// numbered, so the keys do not depend on thread timing. With neither
+/// variable set it forwards to the system's generator.
+#[cfg(target_vendor = "apple")]
+mod hash_seed {
+    use std::ffi::{CStr, c_char, c_void};
+    use std::sync::atomic::{AtomicPtr, AtomicU8, AtomicU64, Ordering};
+
+    unsafe extern "C" {
+        fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
+        fn getenv(name: *const c_char) -> *const c_char;
+    }
+    const RTLD_NEXT: *mut c_void = -1isize as *mut c_void;
+    static REAL: AtomicPtr<c_void> = AtomicPtr::new(std::ptr::null_mut());
+    /// 0: not read yet, 1: unset, 2: `SEED` holds the seed.
+    static STATE: AtomicU8 = AtomicU8::new(0);
+    static SEED: AtomicU64 = AtomicU64::new(0);
+    static SHARED: AtomicU64 = AtomicU64::new(1 << 40);
+    std::thread_local! {
+        static DRAWN: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    }
+
+    fn parse(p: *const c_char) -> Option<u64> {
+        if p.is_null() {
+            return None;
+        }
+        unsafe { CStr::from_ptr(p) }.to_str().ok()?.trim().parse().ok()
+    }
+
+    fn seed() -> Option<u64> {
+        match STATE.load(Ordering::Acquire) {
+            1 => None,
+            2 => Some(SEED.load(Ordering::Relaxed)),
+            _ => {
+                let s = parse(unsafe { getenv(c"RH_HASHSEED".as_ptr()) })
+                    .or_else(|| parse(unsafe { getenv(c"RH_SHUFFLE".as_ptr()) }).map(|s| s ^ 0x5EED_5EED));
+                if let Some(s) = s {
+                    SEED.store(s, Ordering::Relaxed);
+                }
+                STATE.store(if s.is_some() { 2 } else { 1 }, Ordering::Release);
+                s
+            }
+        }
+    }
+
+    fn mix(x: u64) -> u64 {
+        let mut z = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+
+    #[allow(non_snake_case)]
+    #[unsafe(no_mangle)]
+    pub extern "C" fn CCRandomGenerateBytes(bytes: *mut c_void, count: usize) -> i32 {
+        if let Some(seed) = seed() {
+            roundhouse::HASH_KEY_CALLS.fetch_add(1, Ordering::Relaxed);
+            let out = unsafe { std::slice::from_raw_parts_mut(bytes as *mut u8, count) };
+            for chunk in out.chunks_mut(8) {
+                let n = DRAWN
+                    .try_with(|d| {
+                        let n = d.get();
+                        d.set(n + 1);
+                        n
+                    })
+                    .unwrap_or_else(|_| SHARED.fetch_add(1, Ordering::Relaxed));
+                chunk.copy_from_slice(&mix(seed ^ mix(n)).to_le_bytes()[..chunk.len()]);
+            }
+            return 0;
+        }
+        let mut f = REAL.load(Ordering::Acquire);
+        if f.is_null() {
+            f = unsafe { dlsym(RTLD_NEXT, c"CCRandomGenerateBytes".as_ptr()) };
+            REAL.store(f, Ordering::Release);
+        }
+        if f.is_null() {
+            return -1;
+        }
+        let real: extern "C" fn(*mut c_void, usize) -> i32 = unsafe { std::mem::transmute(f) };
+        real(bytes, count)
+    }
+}
