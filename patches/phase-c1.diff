+/// Which non-monotone rule a frozen unit's last two returns point at.
+fn classify(prev: Option<&Ty>, last: Option<&Ty>) -> &'static str {
+    let (Some(a), Some(b)) = (prev, last) else { return "no_return_change" };
+    fn strip(t: &Ty, pred: &dyn Fn(&Ty) -> bool) -> Ty {
+        match t {
+            Ty::Union { variants } => {
+                let kept: Vec<Ty> = variants.iter().filter(|v| !pred(v)).cloned().collect();
+                match kept.len() {
+                    0 => Ty::Bottom,
+                    1 => kept.into_iter().next().unwrap(),
+                    _ => Ty::Union { variants: kept },
+                }
+            }
+            other if pred(other) => Ty::Bottom,
+            other => other.clone(),
+        }
+    }
+    let unknown = |t: &Ty| matches!(t, Ty::Untyped | Ty::Var { .. });
+    if strip(a, &unknown) == strip(b, &unknown) {
+        return "gradual_arm";
+    }
+    let nil = |t: &Ty| matches!(t, Ty::Nil);
+    if strip(a, &nil) == strip(b, &nil) {
+        return "nil_arm";
+    }
+    let widened = |t: &Ty| {
+        matches!(t, Ty::Untyped)
+            || matches!(t, Ty::Array { elem } if matches!(**elem, Ty::Untyped))
+            || matches!(t, Ty::Hash { key, value } if matches!(**key, Ty::Untyped) && matches!(**value, Ty::Untyped))
+    };
+    if widened(a) != widened(b) {
+        return "bound_cut";
+    }
+    let empty_elem = |t: &Ty| match t {
+        Ty::Array { elem } => matches!(**elem, Ty::Bottom | Ty::Var { .. }),
+        _ => false,
+    };
+    if empty_elem(a) && empty_elem(b) {
+        return "empty_literal_stamp";
+    }
+    if let (Ty::Union { variants: va }, Ty::Union { variants: vb }) = (a, b) {
+        if va.len() == vb.len() && va.iter().all(|x| vb.contains(x)) {
+            return "union_order";
+        }
+    }
+    "other"
+}
