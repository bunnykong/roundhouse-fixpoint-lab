+
+    #[test]
+    fn classifier_names_gradual_arm_flips() {
+        let a = Ty::Union { variants: vec![Ty::Str, Ty::Untyped] };
+        assert_eq!(classify(Some(&a), Some(&Ty::Str)), "gradual_arm");
+        let b = Ty::Array { elem: Box::new(Ty::Untyped) };
+        let c = Ty::Array { elem: Box::new(Ty::Array { elem: Box::new(Ty::Int) }) };
+        assert_eq!(classify(Some(&b), Some(&c)), "bound_cut");
+        assert_eq!(classify(None, Some(&c)), "no_return_change");
+    }
