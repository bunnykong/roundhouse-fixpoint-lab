+//! DX8 arm 2 (prototype, pending experiment): SCC body queries.
+//!
+//! Inert unless `RH_SCHED=sccq`. With the flag unset the analyzer runs
+//! main's global rounds (arm 1) unchanged; only cheap counters are kept,
+//! and printed with `RH_SCCQ_STATS=1`.
+//!
+//! Query units are the method bodies of models (plus their scopes) and of
+//! library classes: the bodies the production and absorb rounds spend most
+//! of their time re-typing. Controllers, class-body items, views and tests
+//! keep their class passes (#524's dirty pending), so this is "finishing
+//! #521's deferral on #524's edges" for the method bodies.
+//!
+//! While a unit is typed, the registry classes it fetched and the constants
+//! it read are recorded; the method names it can look up and the ivars it
+//! touches come from its syntax. Slots are registry entries `(class, name)`
+//! (returns, block-value verdicts), parameter rows, class ivar seeds and
+//! constants. The slot-read graph orders units: Tarjan SCCs for the census,
+//! Bourdoncle's weak topological order for the worklist priority. A unit is
+//! re-typed only when a slot it read changed; its return is harvested and
+//! its call sites update parameter rows immediately, so chains settle in one
+//! sweep. A per-unit cap (counted) freezes oscillators.
+//!
+//! The round loop around the engine is main's: each round runs main's global
+//! harvest and unify and stops only on main's own convergence test, so the
+//! engine is an accelerator inside main's stopping criterion.
+
+use std::cell::RefCell;
+use std::cmp::Reverse;
+use std::collections::{BTreeMap, BTreeSet, BinaryHeap, HashMap, HashSet};
+use std::hash::{Hash, Hasher};
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+
+use rubydex::model::ids::DeclarationId;
+
+use crate::expr::{Expr, ExprNode, LValue, Literal};
+use crate::ident::{ClassId, Symbol, TyVar};
+use crate::ty::Ty;
+use crate::App;
+
+use super::body::{ConstScope, Ctx};
+use super::dirty_retype::DirtyHints;
+use super::typing_mode::TypingMode;
+use super::{Analyzer, ParamShape};
+
+// ───────────────────────────── mode ─────────────────────────────
+
+pub(crate) fn sched_sccq() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RH_SCHED").is_ok_and(|v| v == "sccq"))
+}
+
+pub(crate) fn stats_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RH_SCCQ_STATS").is_ok_and(|v| !v.is_empty() && v != "0"))
+}
+
+fn unit_cap() -> u32 {
+    static CAP: OnceLock<u32> = OnceLock::new();
+    *CAP.get_or_init(|| {
+        // prototype (C1): with the fold on the handoffs are joins, so a unit's
+        // output only ascends; a cap of 12 changes froze legitimately long
+        // ascents (Mastodon: 77). The cap stays as a safety net.
+        let default = if super::fold::on() { 200 } else { 12 };
+        std::env::var("RH_SCCQ_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+    })
+}
+
+/// Stretch, CONTROL.md's edit pair (public inputs only): `RH_SCCQ_EDIT=add`
+/// adds `Chain.new.link0(1.5)` in front of the first controller action's
+/// body once production converges, then re-converges incrementally;
+/// `adddel` deletes it again afterwards. Compare digests with cold runs.
+fn edit_plan() -> u8 {
+    static PLAN: OnceLock<u8> = OnceLock::new();
+    *PLAN.get_or_init(|| match std::env::var("RH_SCCQ_EDIT").as_deref() {
+        Ok("add") => 1,
+        Ok("adddel") => 2,
+        _ => 0,
+    })
+}
+
+/// `RH_SCCQ_ORBIT=1`: stop a phase's round loop on a period-2 orbit.
+fn orbit_stop() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RH_SCCQ_ORBIT").is_ok_and(|v| v == "1"))
+}
+
+/// `RH_SCCQ_ORDER=fifo` replaces the WTO priority by arrival order (ablation).
+/// `RH_SCCQ_DEBUG=1` prints one line per unit evaluation with names and
+/// types. Public inputs only: it prints slot names.
+fn debug_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RH_SCCQ_DEBUG").is_ok_and(|v| v == "1"))
+}
+
+/// prototype (C1): `RH_C1_FOLDDEFER=1|0` (default 1): inside a drain, fold
+/// side-table moves are batched to the next round instead of re-queuing
+/// readers at once (registry and row dependencies stay immediate). On the
+/// large app the immediate form cascades through the giant component
+/// while about 4,800 methods enter reference mode at once.
+/// `RH_C1_SUBROUNDS=0` disables the in-round sweeps of `back` (ablation).
+fn subround_off() -> bool {
+    static OFF: OnceLock<bool> = OnceLock::new();
+    *OFF.get_or_init(|| std::env::var("RH_C1_SUBROUNDS").is_ok_and(|v| v == "0"))
+}
+
+/// Modes (`RH_C1_FOLDDEFER`): `back` (default) re-types later readers in the
+/// sweep and batches back edges into in-round sweeps; `all` batches every
+/// move to the next round; `first` batches only in each phase's first drain;
+/// `0` propagates at once (the storm). `first` defers only in each phase's first drain (when
+/// reference mode switches on wholesale); later drains propagate at once.
+fn fold_defer_mode() -> u8 {
+    static MODE: OnceLock<u8> = OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("RH_C1_FOLDDEFER").as_deref() {
+        Ok("0") => 0,
+        Ok("1") | Ok("all") => 1,
+        Ok("first") => 2,
+        _ => 3,
+    })
+}
+
+/// prototype (C1): `RH_C1_CLASSFULL=0` keeps #524's pending for class passes
+/// even when the fold's side table moved (ablation; default: full pass).
+fn side_full_class() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| !std::env::var("RH_C1_CLASSFULL").is_ok_and(|v| v == "0"))
+}
+
+fn fifo_order() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RH_SCCQ_ORDER").is_ok_and(|v| v == "fifo"))
+}
+
+// ─────────────────────────── recorder ───────────────────────────
+
+/// Global gate so arm 1 pays one relaxed load per registry fetch.
+pub(crate) static RECORDING: AtomicBool = AtomicBool::new(false);
+
+/// What one typing of a unit read. Class indices are `ClassInfo::sccq_idx`
+/// (0 = a class created after the engine indexed the registry).
+#[derive(Default, Clone, Debug)]
+pub(crate) struct Reads {
+    pub classes: Vec<u32>,
+    pub wild: Vec<u32>,
+    pub const_ids: Vec<DeclarationId>,
+    pub const_names: Vec<Symbol>,
+    /// prototype (C1): fold slots whose value the typing read (unfolding).
+    pub fold_slots: Vec<u32>,
+}
+
+impl Reads {
+    fn normalize(&mut self) {
+        self.classes.sort_unstable();
+        self.classes.dedup();
+        self.wild.sort_unstable();
+        self.wild.dedup();
+        self.const_ids.sort_unstable();
+        self.const_ids.dedup();
+        self.const_names.sort_unstable_by(|a, b| a.as_str().cmp(b.as_str()));
+        self.const_names.dedup();
+        self.fold_slots.sort_unstable();
+        self.fold_slots.dedup();
+    }
+
+    fn absorb(&mut self, other: Reads) {
+        self.classes.extend(other.classes);
+        self.wild.extend(other.wild);
+        self.const_ids.extend(other.const_ids);
+        self.const_names.extend(other.const_names);
+        self.fold_slots.extend(other.fold_slots);
+        self.normalize();
+    }
+
+    fn reads_class(&self, idx: u32) -> bool {
+        idx == 0
+            || self.classes.binary_search(&idx).is_ok()
+            || self.wild.binary_search(&idx).is_ok()
+            || self.classes.first() == Some(&0)
+    }
+}
+
+thread_local! {
+    static REC: RefCell<Reads> = RefCell::new(Reads::default());
+}
+
+#[inline]
+pub(crate) fn rec_class(idx: u32) {
+    if RECORDING.load(Relaxed) {
+        REC.with(|r| r.borrow_mut().classes.push(idx));
+    }
+}
+
+#[inline]
+pub(crate) fn rec_wild(idx: u32) {
+    if RECORDING.load(Relaxed) {
+        REC.with(|r| r.borrow_mut().wild.push(idx));
+    }
+}
+
+#[inline]
+pub(crate) fn rec_const_id(id: &DeclarationId) {
+    if RECORDING.load(Relaxed) {
+        REC.with(|r| r.borrow_mut().const_ids.push(*id));
+    }
+}
+
+/// prototype (C1): a fold slot's value was read (`fold::value_of`).
+#[inline]
+pub(crate) fn rec_fold_slot(slot: u32) {
+    if RECORDING.load(Relaxed) {
+        REC.with(|r| r.borrow_mut().fold_slots.push(slot));
+    }
+}
+
+#[inline]
+pub(crate) fn rec_const_name(name: &Symbol) {
+    if RECORDING.load(Relaxed) {
+        REC.with(|r| r.borrow_mut().const_names.push(name.clone()));
+    }
+}
+
+fn rec_begin() {
+    REC.with(|r| *r.borrow_mut() = Reads::default());
+    RECORDING.store(true, Relaxed);
+}
+
+fn rec_end() -> Reads {
+    RECORDING.store(false, Relaxed);
+    let mut reads = REC.with(|r| std::mem::take(&mut *r.borrow_mut()));
+    reads.normalize();
+    reads
+}
