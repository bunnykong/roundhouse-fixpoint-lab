+        let new_unit = |eng: &mut Engine, family: Family, ci: usize, mi: usize, entry: usize,
+                        class: &ClassId, name: &Symbol, class_side: bool, body: &Expr,
+                        extra: &[&Expr], own_key: Option<ParamKey>| -> u32 {
+            let (ivars, ivar_write) = scan_ivars(body);
