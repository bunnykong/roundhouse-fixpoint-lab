+    fn ivar_scan_sees_memo_writes() {
+        let ivar = |n: &str| Expr::new(crate::span::Span::synthetic(), ExprNode::Ivar { name: Symbol::from(n) });
+        let body = Expr::new(crate::span::Span::synthetic(), ExprNode::OpAssign {
