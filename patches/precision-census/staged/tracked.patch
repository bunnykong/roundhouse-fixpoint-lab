         assert_eq!(comps, vec![vec![0, 1], vec![2], vec![3]]);
     }
 }
+
+// Opt-in public census: preserve slot origins before recursive references expand.
+pub(super) fn precdiff_slots(classes:&HashMap<ClassId,ClassInfo>)->serde_json::Value {
+    ST.with(|s| {
+        let s=s.borrow();
+        serde_json::Value::Array(s.keys.iter().enumerate().map(|(slot,key)| {
+            let origin=match key {
+                SlotKey::Ret{class,method,class_side}=>serde_json::json!({"kind":"return","class":class.0.as_str(),"method":method.as_str(),"class_side":class_side}),
+                SlotKey::Param{class,method,index}=>serde_json::json!({"kind":"parameter","class":class.0.as_str(),"method":method.as_str(),"index":index}),
+                SlotKey::Narrow{site,filter}=>serde_json::json!({"kind":"narrowing","site":site,"filter":filter}),
+                SlotKey::At{site,step}=>serde_json::json!({"kind":"position","site":site,"step":format!("{step:?}")}),
+            };
+            let value=match key {
+                SlotKey::Ret{class,method,class_side}=>classes.get(class).and_then(|c| {
+                    let table=if *class_side {&c.class_methods} else {&c.instance_methods};
+                    table.get(method).map(|t|match t {Ty::Fn{ret,..}=>(**ret).clone(),other=>other.clone()})
+                }),
+                _=>s.values.get(&(slot as u32)).cloned(),
+            };
+            serde_json::json!({"slot":slot,"origin":origin,"type":value})
+        }).collect())
+    })
+}
