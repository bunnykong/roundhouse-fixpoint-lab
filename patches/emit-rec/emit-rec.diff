+//! Recursive emission (`RH_EMIT_REC=1`): recursive aliases as Rust enums.
+//!
+//! Each alias (`analyze::rec_alias`) becomes `enum J { Int(i64), Str(String),
+//! Array(Vec<J>), Hash(Vec<(String, J)>), Nil }` in `src/models/rh_rec.rs`,
+//! reachable from every controller and view through `crate::models::*`. A
+//! Hash is a `Vec` of pairs because Ruby's Hash keeps insertion order. The
+//! enum prints as Ruby does (`to_s`, Ruby 3.4's `inspect`).
+//!
+//! A method of the component is emitted from its types: `is_a?` and
+//! `case … when Hash / when Array` on a `J` binding become `match` arms on
+//! its variants, with the binding narrowed to the payload; each arm's value
+//! is injected back into `J`. A shape this does not cover returns `None`,
+//! and the method is emitted as before.
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use crate::analyze::rec_alias::{self, RecAlias};
+use crate::dialect::MethodDef;
+use crate::emit::EmittedFile;
+use crate::expr::{Expr, ExprNode, Literal, Pattern};
+use crate::ident::{ClassId, Symbol};
+use crate::ty::Ty;
+
+thread_local! {
+    static REC_CLASS: RefCell<Option<ClassId>> = const { RefCell::new(None) };
+}
+
+/// Run `f` with `class` as the class whose method is being emitted.
+pub(super) fn with_rec_class<T>(class: Option<&Symbol>, f: impl FnOnce() -> T) -> T {
+    let prev = REC_CLASS.with(|c| c.replace(class.map(|s| ClassId(s.clone()))));
+    let out = f();
+    REC_CLASS.with(|c| *c.borrow_mut() = prev);
+    out
+}
+
+fn rec_class() -> Option<ClassId> {
+    REC_CLASS.with(|c| c.borrow().clone())
+}
+
+/// The variants an alias' body has.
+struct Arms {
+    name: String,
+    int: bool,
+    float: bool,
+    boolean: bool,
+    str: bool,
+    sym: bool,
+    nil: bool,
+    array: bool,
+    /// The Rust key type of the Hash arm, when there is one.
+    hash: Option<String>,
+}
+
+impl Arms {
+    fn of(name: &str, body: &Ty) -> Option<Arms> {
+        let mut a = Arms {
+            name: name.to_string(),
+            int: false, float: false, boolean: false, str: false, sym: false, nil: false, array: false, hash: None,
+        };
+        let arms: Vec<&Ty> = match body {
+            Ty::Union { variants } => variants.iter().collect(),
+            t => vec![t],
+        };
+        for t in arms {
+            match t {
+                Ty::Int => a.int = true,
+                Ty::Float => a.float = true,
+                Ty::Bool => a.boolean = true,
+                Ty::Str => a.str = true,
+                Ty::Sym => a.sym = true,
+                Ty::Nil => a.nil = true,
+                Ty::Array { .. } => a.array = true,
+                Ty::Hash { key, .. } => {
+                    a.hash = Some(match &**key {
+                        Ty::Str | Ty::Sym => "String".to_string(),
+                        Ty::Int => "i64".to_string(),
+                        k if rec_alias::body_of(k).is_some() => name.to_string(),
+                        _ => return None,
+                    })
+                }
+                _ => return None,
+            }
+        }
+        Some(a)
+    }
+
+    fn decl(&self) -> String {
+        let j = &self.name;
+        let mut vs = Vec::new();
+        let mut ins = Vec::new();
+        let mut push = |on: bool, v: String, i: &str| {
+            if on {
+                vs.push(v);
+                ins.push(i.to_string());
+            }
+        };
+        push(self.int, "Int(i64)".into(), "            Self::Int(n) => n.to_string(),");
+        push(self.float, "Float(f64)".into(), "            Self::Float(f) => format!(\"{f:?}\"),");
+        push(self.boolean, "Bool(bool)".into(), "            Self::Bool(b) => b.to_string(),");
+        push(self.str, "Str(String)".into(), "            Self::Str(s) => rh_quote(s),");
+        push(self.sym, "Sym(String)".into(), "            Self::Sym(s) => format!(\":{s}\"),");
+        push(self.array, format!("Array(Vec<{j}>)"),
+            "            Self::Array(xs) => format!(\"[{}]\", xs.iter().map(|x| x.rh_inspect()).collect::<Vec<_>>().join(\", \")),");
+        let key_inspect = match self.hash.as_deref() {
+            Some("String") => "rh_quote(k)",
+            Some("i64") => "k.to_string()",
+            _ => "k.rh_inspect()",
+        };
+        if let Some(k) = &self.hash {
+            vs.push(format!("Hash(Vec<({k}, {j})>)"));
+            ins.push(format!(
+                "            Self::Hash(kvs) if kvs.is_empty() => \"{{}}\".to_string(),\n            Self::Hash(kvs) => format!(\"{{{{{{}}}}}}\", kvs.iter().map(|(k, v)| format!(\"{{}} => {{}}\", {key_inspect}, v.rh_inspect())).collect::<Vec<_>>().join(\", \")),"
+            ));
+        }
+        if self.nil {
+            vs.push("Nil".into());
+            ins.push("            Self::Nil => \"nil\".to_string(),".into());
+        }
+        let default = if self.nil { "Self::Nil" } else if self.hash.is_some() { "Self::Hash(Vec::new())" }
+            else if self.array { "Self::Array(Vec::new())" } else if self.int { "Self::Int(0)" } else { "Self::Str(String::new())" };
+        let merge = match &self.hash {
+            Some(k) => format!(
+                "    /// Ruby's `Hash#merge`; any other arm raises NoMethodError in Ruby.\n    pub fn rh_merge(self, other: Vec<({k}, {j})>) -> {j} {{\n        match self {{\n            Self::Hash(mut h) => {{\n                for (k, v) in other {{\n                    match h.iter_mut().find(|e| e.0 == k) {{\n                        Some(e) => e.1 = v,\n                        None => h.push((k, v)),\n                    }}\n                }}\n                Self::Hash(h)\n            }}\n            other => panic!(\"NoMethodError: undefined method 'merge' for {{}}\", other.rh_inspect()),\n        }}\n    }}\n"
+            ),
+            None => String::new(),
+        };
+        format!(
+            "/// A recursive type from the analyzer (RH_EMIT_REC).\n#[derive(Clone, Debug, PartialEq)]\npub enum {j} {{\n    {}\n}}\n\nimpl Default for {j} {{\n    fn default() -> Self {{\n        {default}\n    }}\n}}\n\nimpl {j} {{\n    /// Ruby's `inspect`.\n    pub fn rh_inspect(&self) -> String {{\n        match self {{\n{}\n        }}\n    }}\n\n{merge}}}\n\nimpl crate::http::RubyToS for {j} {{\n    fn ruby_to_s(&self) -> String {{\n        match self {{\n{}{}            other => other.rh_inspect(),\n        }}\n    }}\n}}\n\n/// Ruby's `to_s`, for views that interpolate the value.\nimpl std::fmt::Display for {j} {{\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {{\n        f.write_str(&crate::http::RubyToS::ruby_to_s(self))\n    }}\n}}\n",
+            vs.join(",\n    "),
+            ins.join("\n"),
+            if self.str { "            Self::Str(s) => s.clone(),\n" } else { "" },
+            if self.nil { "            Self::Nil => String::new(),\n" } else { "" },
+        )
+    }
+}
+
+const QUOTE: &str = "/// Ruby's `String#inspect` for the characters an app's strings use.\nfn rh_quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    let cs: Vec<char> = s.chars().collect();\n    for (i, c) in cs.iter().enumerate() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '#' if matches!(cs.get(i + 1), Some('{' | '$' | '@')) => out.push_str(\"\\\\#\"),\n            c => out.push(*c),\n        }\n    }\n    out.push('\"');\n    out\n}\n";
+
+/// Add `src/models/rh_rec.rs` and re-export it from `src/models/mod.rs`.
+pub(super) fn add_files(files: &mut Vec<EmittedFile>) {
+    let aliases: Vec<RecAlias> = rec_alias::all();
+    let decls: Vec<String> =
+        aliases.iter().filter_map(|a| Arms::of(&a.name, &a.body)).map(|arms| arms.decl()).collect();
+    if decls.is_empty() {
+        return;
+    }
+    let content = format!("// Generated by Roundhouse (RH_EMIT_REC): recursive types.\n\n{QUOTE}\n{}", decls.join("\n"));
+    files.push(EmittedFile { path: PathBuf::from("src/models/rh_rec.rs"), content });
+    let mod_rs = PathBuf::from("src/models/mod.rs");
+    let mut found = false;
+    for f in files.iter_mut().filter(|f| f.path == mod_rs) {
+        f.content.push_str("pub mod rh_rec;\npub use rh_rec::*;\n");
+        found = true;
+    }
+    if !found {
+        files.push(EmittedFile { path: mod_rs, content: "pub mod rh_rec;\npub use rh_rec::*;\n".into() });
+    }
+}
+
+/// What an emitted expression is, in the alias' terms.
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Rt {
+    Alias,
+    /// The Hash arm's payload, `Vec<(K, J)>`.
+    HashP,
+    /// The Array arm's payload, `Vec<J>`.
+    ArrayP,
+    Str,
+    Int,
+    Nil,
+}
+
+fn alias_name(t: &Ty) -> Option<String> {
+    rec_alias::body_of(t)?;
+    match t {
+        Ty::Class { id, .. } => Some(id.0.as_str().to_string()),
+        _ => None,
+    }
+}
+
+fn self_call(recv: Option<&Expr>) -> bool {
+    recv.is_none_or(|r| matches!(&*r.node, ExprNode::SelfRef))
+}
+
+struct Body<'a> {
+    arms: &'a Arms,
+    class: ClassId,
+}
+
+impl Body<'_> {
+    fn inject(&self, (s, t): (String, Rt)) -> Option<String> {
+        let j = &self.arms.name;
+        Some(match t {
+            Rt::Alias => s,
+            Rt::HashP if self.arms.hash.is_some() => format!("{j}::Hash({s})"),
+            Rt::ArrayP if self.arms.array => format!("{j}::Array({s})"),
+            Rt::Str if self.arms.str => format!("{j}::Str({s})"),
+            Rt::Int if self.arms.int => format!("{j}::Int({s})"),
+            Rt::Nil if self.arms.nil => format!("{j}::Nil"),
+            _ => return None,
+        })
+    }
+
+    /// The variant `when <class>` selects, and the binding's payload type.
+    fn variant(&self, class: &str) -> Option<(&'static str, Rt)> {
+        match class {
+            "Hash" if self.arms.hash.is_some() => Some(("Hash", Rt::HashP)),
+            "Array" if self.arms.array => Some(("Array", Rt::ArrayP)),
+            "String" if self.arms.str => Some(("Str", Rt::Str)),
+            "Integer" if self.arms.int => Some(("Int", Rt::Int)),
+            _ => None,
+        }
+    }
+
+    fn expr(&self, e: &Expr, env: &HashMap<String, Rt>) -> Option<(String, Rt)> {
+        let j = &self.arms.name;
+        match &*e.node {
+            ExprNode::Var { name, .. } => Some((name.as_str().to_string(), *env.get(name.as_str())?)),
+            ExprNode::Seq { exprs } if exprs.len() == 1 => self.expr(&exprs[0], env),
+            ExprNode::Lit { value: Literal::Str { value } } => Some((format!("{value:?}.to_string()"), Rt::Str)),
+            ExprNode::Lit { value: Literal::Int { value } } => Some((format!("{value}_i64"), Rt::Int)),
+            ExprNode::Lit { value: Literal::Nil } => Some((String::new(), Rt::Nil)),
+            ExprNode::If { cond, then_branch, else_branch } => {
+                let ExprNode::Send { recv: Some(r), method, args, .. } = &*cond.node else { return None };
+                let (ExprNode::Var { name: x, .. }, [arg]) = (&*r.node, args.as_slice()) else { return None };
+                let ExprNode::Const { path } = &*arg.node else { return None };
+                if method.as_str() != "is_a?" || env.get(x.as_str()) != Some(&Rt::Alias) {
+                    return None;
+                }
+                let (variant, payload) = self.variant(path.last()?.as_str())?;
+                let mut inner = env.clone();
+                inner.insert(x.as_str().to_string(), payload);
+                let t = self.inject(self.expr(then_branch, &inner)?)?;
+                let f = self.inject(self.expr(else_branch, env)?)?;
+                Some((format!("match {x} {{\n    {j}::{variant}({x}) => {{ {t} }}\n    {x} => {{ {f} }}\n}}"), Rt::Alias))
+            }
+            ExprNode::Case { scrutinee, arms } => {
+                let ExprNode::Var { name: x, .. } = &*scrutinee.node else { return None };
+                if env.get(x.as_str()) != Some(&Rt::Alias) {
+                    return None;
+                }
+                let mut out = Vec::new();
+                let mut has_else = false;
+                for arm in arms {
+                    if arm.guard.is_some() {
+                        return None;
+                    }
+                    match &arm.pattern {
+                        Pattern::Expr { expr } => {
+                            let ExprNode::Const { path } = &*expr.node else { return None };
+                            let (variant, payload) = self.variant(path.last()?.as_str())?;
+                            let mut inner = env.clone();
+                            inner.insert(x.as_str().to_string(), payload);
+                            let v = self.inject(self.expr(&arm.body, &inner)?)?;
+                            out.push(format!("    {j}::{variant}({x}) => {{ {v} }}"));
+                        }
+                        Pattern::Wildcard => {
+                            has_else = true;
+                            out.push(format!("    {x} => {{ {} }}", self.inject(self.expr(&arm.body, env)?)?));
+                        }
+                        _ => return None,
+                    }
+                }
+                if !has_else {
+                    out.push(format!("    _ => {}", self.inject((String::new(), Rt::Nil))?));
+                }
+                Some((format!("match {x} {{\n{}\n}}", out.join("\n")), Rt::Alias))
+            }
+            ExprNode::Send { recv, method, args, block, .. } => {
+                self.send(recv.as_ref(), method.as_str(), args, block.as_ref(), env)
+            }
+            _ => None,
+        }
+    }
+
+    fn send(&self, recv: Option<&Expr>, method: &str, args: &[Expr], block: Option<&Expr>, env: &HashMap<String, Rt>) -> Option<(String, Rt)> {
+        if self_call(recv) && block.is_none() {
+            let m = Symbol::from(method);
+            alias_name(&rec_alias::ret_alias(&self.class, &m)?).filter(|n| *n == self.arms.name)?;
+            let mut vs = Vec::new();
+            for (i, a) in args.iter().enumerate() {
+                alias_name(&rec_alias::param_alias(&self.class, &m, i)?).filter(|n| *n == self.arms.name)?;
+                vs.push(self.inject(self.expr(a, env)?)?);
+            }
+            return Some((format!("self.{method}({})", vs.join(", ")), Rt::Alias));
+        }
+        let r = recv?;
+        let lambda = |b: Option<&Expr>| match b.map(|b| &*b.node) {
+            Some(ExprNode::Lambda { params, body, .. }) => Some((params.clone(), body.clone())),
+            _ => None,
+        };
+        match (method, args) {
+            ("transform_values", []) | ("map", []) => {
+                let (rs, rt) = self.expr(r, env)?;
+                let (params, body) = lambda(block)?;
+                let [p] = params.as_slice() else { return None };
+                let mut inner = env.clone();
+                inner.insert(p.as_str().to_string(), Rt::Alias);
+                let v = self.inject(self.expr(&body, &inner)?)?;
+                match (method, rt) {
+                    ("transform_values", Rt::HashP) => Some((
+                        format!("{rs}.into_iter().map(|(__k, {p})| (__k, {v})).collect::<Vec<_>>()"),
+                        Rt::HashP,
+                    )),
+                    ("map", Rt::ArrayP) => Some((format!("{rs}.into_iter().map(|{p}| {v}).collect::<Vec<_>>()"), Rt::ArrayP)),
+                    _ => None,
+                }
+            }
+            // `h.sort.to_h { |k, v| [a, b] }`: a Hash's keys are unique, so
+            // sorting its pairs sorts by key.
+            ("to_h", []) => {
+                let ExprNode::Send { recv: Some(h), method: sort, args: sargs, block: None, .. } = &*r.node else { return None };
+                if sort.as_str() != "sort" || !sargs.is_empty() || self.arms.hash.as_deref() != Some("String") {
+                    return None;
+                }
+                let (hs, Rt::HashP) = self.expr(h, env)? else { return None };
+                let (params, body) = lambda(block)?;
+                let [k, v] = params.as_slice() else { return None };
+                let ExprNode::Array { elements, .. } = &*body.node else { return None };
+                let [ke, ve] = elements.as_slice() else { return None };
+                let mut inner = env.clone();
+                inner.insert(k.as_str().to_string(), Rt::Str);
+                inner.insert(v.as_str().to_string(), Rt::Alias);
+                let (ks, Rt::Str) = self.expr(ke, &inner)? else { return None };
+                let vs = self.inject(self.expr(ve, &inner)?)?;
+                Some((
+                    format!("{{ let mut __p = {hs}; __p.sort_by(|x, y| x.0.cmp(&y.0)); __p.into_iter().map(|({k}, {v})| ({ks}, {vs})).collect::<Vec<_>>() }}"),
+                    Rt::HashP,
+                ))
+            }
+            ("to_s", []) if block.is_none() => match self.expr(r, env)? {
+                (rs, Rt::Str) => Some((format!("{rs}.to_string()"), Rt::Str)),
+                _ => None,
+            },
+            _ => None,
+        }
+    }
+}
+
+/// The body of a method in a recursive component, from its types; `None`
+/// when a shape is not covered.
+pub(super) fn emit_body(m: &MethodDef) -> Option<String> {
+    let class = ClassId(m.enclosing_class.clone()?);
+    let alias = rec_alias::ret_alias(&class, &m.name)?;
+    let name = alias_name(&alias)?;
+    let arms = Arms::of(&name, &rec_alias::body_of(&alias)?)?;
+    let mut env = HashMap::new();
+    for (i, p) in m.params.iter().enumerate() {
+        alias_name(&rec_alias::param_alias(&class, &m.name, i)?).filter(|n| *n == name)?;
+        env.insert(p.name.as_str().to_string(), Rt::Alias);
+    }
+    let b = Body { arms: &arms, class };
+    b.inject(b.expr(&m.body, &env)?)
+}
+
+/// A send outside the component's bodies that the alias changes: a call
+/// into the component, whose arguments are built as the alias, or `merge`
+/// on an alias value.
+pub(super) fn emit_send(e: &Expr) -> Option<String> {
+    if !rec_alias::on() {
+        return None;
+    }
+    let ExprNode::Send { recv, method, args, block: None, .. } = &*e.node else { return None };
+    if self_call(recv.as_ref()) {
+        let class = rec_class()?;
+        rec_alias::ret_alias(&class, method)?;
+        let mut vs = Vec::new();
+        for (i, a) in args.iter().enumerate() {
+            let p = rec_alias::param_alias(&class, method, i)?;
+            let name = alias_name(&p)?;
+            vs.push(build(a, &Arms::of(&name, &rec_alias::body_of(&p)?)?)?);
+        }
+        return Some(format!("self.{method}({})", vs.join(", ")));
+    }
+    let r = recv.as_ref()?;
+    if method.as_str() == "merge" && args.len() == 1 {
+        let t = r.ty.as_ref()?;
+        let arms = Arms::of(&alias_name(t)?, &rec_alias::body_of(t)?)?;
+        let pairs = hash_pairs(&args[0], &arms)?;
+        let rs = super::expr::emit_expr(r);
+        let owned = if rs.ends_with(".clone()") { rs } else { format!("{rs}.clone()") };
+        return Some(format!("{owned}.rh_merge({pairs})"));
+    }
+    None
+}
+
+/// `e` built as the alias: literals become its constructors; an
+/// expression already typed as the alias (a call into the component, a
+/// `merge` on an alias value) is emitted as it is.
+fn build(e: &Expr, arms: &Arms) -> Option<String> {
+    let j = &arms.name;
+    match &*e.node {
+        ExprNode::Lit { value: Literal::Int { value } } if arms.int => Some(format!("{j}::Int({value}_i64)")),
+        ExprNode::Lit { value: Literal::Str { value } } if arms.str => Some(format!("{j}::Str({value:?}.to_string())")),
+        ExprNode::Lit { value: Literal::Nil } if arms.nil => Some(format!("{j}::Nil")),
+        ExprNode::Array { elements, .. } if arms.array => {
+            let xs = elements.iter().map(|x| build(x, arms)).collect::<Option<Vec<_>>>()?;
+            Some(format!("{j}::Array(vec![{}])", xs.join(", ")))
+        }
+        ExprNode::Hash { .. } if arms.hash.is_some() => Some(format!("{j}::Hash({})", hash_pairs(e, arms)?)),
+        ExprNode::Send { recv: Some(r), method, .. }
+            if method.as_str() == "merge" && r.ty.as_ref().and_then(alias_name).as_deref() == Some(j.as_str()) =>
+        {
+            Some(super::expr::emit_expr(e))
+        }
+        ExprNode::Send { recv, method, .. } if self_call(recv.as_ref()) => {
+            let ret = rec_alias::ret_alias(&rec_class()?, method)?;
+            (alias_name(&ret)?.as_str() == j.as_str()).then(|| super::expr::emit_expr(e))
+        }
+        ExprNode::Var { .. } if e.ty.as_ref().and_then(alias_name).as_deref() == Some(j.as_str()) => {
+            Some(format!("{}.clone()", super::expr::emit_expr(e)))
+        }
+        _ => None,
+    }
+}
+
+/// A Hash literal's entries as the alias' Hash payload, `vec![(k, v), …]`.
+fn hash_pairs(e: &Expr, arms: &Arms) -> Option<String> {
+    let ExprNode::Hash { entries, .. } = &*e.node else { return None };
+    let key = arms.hash.as_deref()?;
+    let mut ps = Vec::new();
+    for (k, v) in entries {
+        let ks = match (&*k.node, key) {
+            (ExprNode::Lit { value: Literal::Str { value } }, "String") => format!("{value:?}.to_string()"),
+            (ExprNode::Lit { value: Literal::Sym { value } }, "String") => format!("{:?}.to_string()", value.as_str()),
+            (ExprNode::Lit { value: Literal::Int { value } }, "i64") => format!("{value}_i64"),
+            _ => return None,
+        };
+        ps.push(format!("({ks}, {})", build(v, arms)?));
+    }
+    Some(format!("vec![{}]", ps.join(", ")))
+}
