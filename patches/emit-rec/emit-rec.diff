+
+/// Arms collected for a `rec_aliases` body.
+struct Universe<'a> {
+    members: &'a HashSet<u32>,
+    values: &'a HashMap<u32, Ty>,
+    seen: HashSet<u32>,
+    scalars: Vec<Ty>,
+    has_array: bool,
+    has_hash: bool,
+    keys: Vec<Ty>,
+    key_is_rec: bool,
+    dropped: u64,
+    unsupported: bool,
+}
+
+impl<'a> Universe<'a> {
+    fn new(members: &'a HashSet<u32>, values: &'a HashMap<u32, Ty>) -> Self {
+        Universe {
+            members,
+            values,
+            seen: HashSet::new(),
+            scalars: Vec::new(),
+            has_array: false,
+            has_hash: false,
+            keys: Vec::new(),
+            key_is_rec: false,
+            dropped: 0,
+            unsupported: false,
+        }
+    }
+
+    /// A value position: its arms join the alias.
+    fn arm(&mut self, t: &Ty) {
+        match t {
+            Ty::Union { variants } => variants.iter().for_each(|v| self.arm(v)),
+            Ty::Rec { slot } => {
+                if !self.members.contains(slot) && self.seen.insert(*slot) {
+                    if let Some(v) = self.values.get(slot).cloned() {
+                        self.arm(&v);
+                    }
+                }
+            }
+            Ty::Array { elem } => {
+                self.has_array = true;
+                self.arm(elem);
+            }
+            Ty::Tuple { elems } => {
+                self.has_array = true;
+                elems.iter().for_each(|e| self.arm(e));
+            }
+            Ty::Hash { key, value } => {
+                self.has_hash = true;
+                self.key(key);
+                self.arm(value);
+            }
+            Ty::Untyped | Ty::Var { .. } => self.dropped += 1,
+            Ty::Bottom => {}
+            Ty::Record { .. } | Ty::Fn { .. } | Ty::Relation { .. } | Ty::SelfInstance => self.unsupported = true,
+            scalar => {
+                if !self.scalars.contains(scalar) {
+                    self.scalars.push(scalar.clone());
+                }
+            }
+        }
+    }
+
+    /// A Hash key position: scalars join `K`; a container or the
+    /// component itself makes `K` the alias.
+    fn key(&mut self, t: &Ty) {
+        match t {
+            Ty::Union { variants } => variants.iter().for_each(|v| self.key(v)),
+            Ty::Rec { slot } if self.members.contains(slot) => self.key_is_rec = true,
+            Ty::Rec { slot } => {
+                if self.seen.insert(*slot) {
+                    if let Some(v) = self.values.get(slot).cloned() {
+                        self.key(&v);
+                    }
+                }
+            }
+            Ty::Array { .. } | Ty::Tuple { .. } | Ty::Hash { .. } => {
+                self.key_is_rec = true;
+                self.arm(t);
+            }
+            Ty::Untyped | Ty::Var { .. } => self.dropped += 1,
+            Ty::Bottom => {}
+            Ty::Record { .. } | Ty::Fn { .. } | Ty::Relation { .. } | Ty::SelfInstance => self.unsupported = true,
+            scalar => {
+                if !self.keys.contains(scalar) {
+                    self.keys.push(scalar.clone());
+                }
+            }
+        }
+    }
+}
+
+fn scalar_rank(t: &Ty) -> (u8, String) {
+    let r = match t {
+        Ty::Int => 0,
+        Ty::Float => 1,
+        Ty::Bool => 2,
+        Ty::Str => 3,
+        Ty::Sym => 4,
+        Ty::Date => 5,
+        Ty::Time => 6,
+        Ty::Class { .. } => 7,
+        _ => 8,
+    };
+    (r, rbs(t))
+}
