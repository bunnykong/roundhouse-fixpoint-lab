+//! Recursive emission research prototype (`RH_EMIT_REC=1`, with `RH_FOLD=1`):
+//! keep the fold's recursive grammars for the emitters.
+//!
+//! The fold types a recursive component's returns by reference, and its
+//! final expansion cuts every cyclic back edge to `untyped`, so an emitter
+//! sees a finite tree with `untyped` leaves (the Rust gap recorded in
+//! rubys/roundhouse#589). With this flag on, each strongly connected
+//! component of cyclic slots that holds a method return also becomes one
+//! named alias `J`, the least type closed under its slots' arms:
+//!
+//! ```text
+//! J = scalar arms | Array[J] (if any Array arm) | Hash[K, J] (if any Hash arm)
+//! ```
+//!
+//! `K` is the union of the Hash arms' key types, or `J` when a key can
+//! hold a container. The component's parameter slots contribute their
+//! arms too, so every parameter of its methods fits `J` by construction.
+//! `untyped` arms are left out and counted (`dropped_gradual`): the target
+//! compiler checks every flow into `J`, so a dropped arm that is live
+//! surfaces as a compile error, never as a wrong value.
+//!
+//! The fold's analysis is unchanged except for one typing rule under the
+//! flag: a `to_h` block whose value is a two-element array literal answers
+//! a pair, so `h.sort.to_h { |k, v| [k.to_s, f(v)] }` is `Hash[String, R]`,
+//! not `Hash[String | R, String | R]`. The lowerer types the component's
+//! methods with the alias (`ret_alias`, `param_alias`), and its re-typing
+//! narrows an alias through its body (`narrowable`). An emitter declares
+//! each alias from `all()`: Crystal as `alias J = …`, Rust as an `enum`.
+use std::collections::HashMap;
+use std::sync::{LazyLock, Mutex};
+
+use crate::ident::{ClassId, Symbol};
+use crate::ty::Ty;
+
+static ON: LazyLock<bool> = LazyLock::new(|| {
+    std::env::var("RH_EMIT_REC").is_ok_and(|s| s == "1") && std::env::var("RH_FOLD").is_ok_and(|s| s == "1")
+});
+
+/// `RH_EMIT_REC=1` with `RH_FOLD=1`; off (and every rule here inert)
+/// without the fold.
+pub fn on() -> bool {
+    *ON
+}
+
+#[derive(Clone, Debug)]
+pub struct RecAlias {
+    /// A type-like name (`TreesControllerCanonicalRet`).
+    pub name: String,
+    /// A union whose container arms refer back to `alias_ty(name)`.
+    pub body: Ty,
+    /// The methods whose return is this alias, in slot-name order.
+    pub methods: Vec<(ClassId, Symbol)>,
+    /// `untyped` arms left out of the body.
+    pub dropped_gradual: u64,
+}
+
+#[derive(Default)]
+struct Registry {
+    aliases: Vec<RecAlias>,
+    rets: HashMap<(ClassId, Symbol), usize>,
+    params: HashMap<(ClassId, Symbol, usize), usize>,
+}
+
+static REG: LazyLock<Mutex<Registry>> = LazyLock::new(Default::default);
+
+/// Replace the registry with one analysis' aliases. `params` maps a
+/// parameter position to the index of the alias it is typed with.
+pub(crate) fn set(aliases: Vec<RecAlias>, params: Vec<((ClassId, Symbol, usize), usize)>) {
+    let mut reg = REG.lock().unwrap();
+    reg.rets.clear();
+    for (i, a) in aliases.iter().enumerate() {
+        for m in &a.methods {
+            reg.rets.insert(m.clone(), i);
+        }
+    }
+    reg.params = params.into_iter().collect();
+    reg.aliases = aliases;
+}
+
+/// The nominal type an alias is referred to by.
+pub fn alias_ty(name: &str) -> Ty {
+    Ty::Class { id: ClassId(Symbol::from(name)), args: vec![].into() }
+}
+
+/// The alias `class#method` returns, if it is in a recursive component.
+pub fn ret_alias(class: &ClassId, method: &Symbol) -> Option<Ty> {
+    if !on() {
+        return None;
+    }
+    let reg = REG.lock().unwrap();
+    let i = *reg.rets.get(&(class.clone(), method.clone()))?;
+    Some(alias_ty(&reg.aliases[i].name))
+}
+
+/// The alias parameter `index` of `class#method` is typed with.
+pub fn param_alias(class: &ClassId, method: &Symbol, index: usize) -> Option<Ty> {
+    if !on() {
+        return None;
+    }
+    let reg = REG.lock().unwrap();
+    let i = *reg.params.get(&(class.clone(), method.clone(), index))?;
+    Some(alias_ty(&reg.aliases[i].name))
+}
+
+/// The body of the alias `t` names, when `t` is one.
+pub fn body_of(t: &Ty) -> Option<Ty> {
+    if !on() {
+        return None;
+    }
+    let Ty::Class { id, args } = t else { return None };
+    if !args.is_empty() {
+        return None;
+    }
+    let reg = REG.lock().unwrap();
+    reg.aliases.iter().find(|a| a.name == id.0.as_str()).map(|a| a.body.clone())
+}
+
+/// True when `t` mentions a registered alias anywhere.
+pub fn mentions_alias(t: &Ty) -> bool {
+    if !on() {
+        return false;
+    }
+    let reg = REG.lock().unwrap();
+    if reg.aliases.is_empty() {
+        return false;
+    }
+    fn go(t: &Ty, names: &[String]) -> bool {
+        match t {
+            Ty::Class { id, args } => names.iter().any(|n| n == id.0.as_str()) || args.iter().any(|a| go(a, names)),
+            Ty::Union { variants } => variants.iter().any(|v| go(v, names)),
+            Ty::Array { elem } => go(elem, names),
+            Ty::Hash { key, value } => go(key, names) || go(value, names),
+            Ty::Tuple { elems } => elems.iter().any(|e| go(e, names)),
+            _ => false,
+        }
+    }
+    let names: Vec<String> = reg.aliases.iter().map(|a| a.name.clone()).collect();
+    go(t, &names)
+}
+
+/// What a narrowing should start from when `t` involves an alias: the
+/// body for the alias itself, `t` for a type that mentions one (both are
+/// then narrowed by constructor head, as the fold narrows a reference).
+pub fn narrowable(t: &Ty) -> Option<Ty> {
+    if let Some(body) = body_of(t) {
+        return Some(body);
+    }
+    mentions_alias(t).then(|| t.clone())
+}
+
+/// Every registered alias, in registration order.
+pub fn all() -> Vec<RecAlias> {
+    if !on() {
+        return Vec::new();
+    }
+    REG.lock().unwrap().aliases.clone()
+}
+
+/// `trees_controller_canonical_ret` → `TreesControllerCanonicalRet`.
+pub(crate) fn camel(snake: &str) -> String {
+    snake
+        .split('_')
+        .filter(|p| !p.is_empty())
+        .map(|p| {
+            let mut cs = p.chars();
+            match cs.next() {
+                Some(c) => c.to_ascii_uppercase().to_string() + cs.as_str(),
+                None => String::new(),
+            }
+        })
+        .collect()
+}
