+    crate::analyze::rec_alias::param_alias(&crate::ident::ClassId(class), method, index)
+}
+
+/// Recursive emission (`RH_EMIT_REC=1`): sends on values of a recursive alias
+/// that Crystal spells differently from Ruby.
+///
+/// - `h.sort.to_h { |k, v| [a, b] }` on a Hash holding the alias: Ruby
+///   sorts `[key, value]` pairs, and a Hash's keys are unique, so this is
+///   `h.keys.sort.to_h { |k| v = h[k]; {a, b} }`. Crystal's own sorts
+///   would need `<=>` on `J`, and any sort over tuples holding `J`
+///   instantiates `Tuple(…, J)#to_s`, which Crystal 1.21 rejects.
+/// - `pairs.to_h { |k, v| [a, b] }`: Crystal's block returns a Tuple.
+/// - `j.merge(h)` on an alias receiver: only the Hash arm has `merge`.
+///   Cast to it (Ruby raises NoMethodError on another arm; Crystal raises
+///   TypeCastError) and build the argument as that arm.
+fn emit_rec_send(recv: Option<&Expr>, method: &Symbol, args: &[Expr], block: Option<&Expr>) -> Option<String> {
+    use crate::analyze::rec_alias;
+    if !rec_alias::on() {
+        return None;
+    }
+    let r = recv?;
+    let r_ty = r.ty.as_ref()?;
+    match (method.as_str(), args, block) {
+        ("to_h", [], Some(b)) => {
+            let ExprNode::Lambda { params, body, .. } = &*b.node else { return None };
+            let ExprNode::Array { elements, .. } = &*body.node else { return None };
+            let [a, b] = elements.as_slice() else { return None };
+            let ps: Vec<String> = params.iter().map(|p| p.to_string()).collect();
+            let pair = format!("{{{}, {}}}", emit_rec_value(a), emit_rec_value(b));
+            if let ExprNode::Send { recv: Some(h), method: sort, args: sort_args, block: None, .. } = &*r.node {
+                let hash_of_alias = h.ty.as_ref().is_some_and(|t| matches!(t, Ty::Hash { .. }) && rec_alias::mentions_alias(t));
+                if sort.as_str() == "sort" && sort_args.is_empty() && hash_of_alias && ps.len() == 2
+                    && matches!(&*h.node, ExprNode::Var { .. })
+                {
+                    let h_s = emit_expr(h);
+                    let (k, v) = (&ps[0], &ps[1]);
+                    return Some(format!("{h_s}.keys.sort.to_h {{ |{k}| {v} = {h_s}[{k}]; {pair} }}"));
+                }
+            }
+            if !rec_alias::mentions_alias(r_ty) {
+                return None;
+            }
+            Some(format!("{}.to_h {{ |{}| {pair} }}", emit_expr(r), ps.join(", ")))
+        }
+        ("merge", [arg], None) => {
+            let body = rec_alias::body_of(r_ty)?;
+            let arms: Vec<Ty> = match body {
+                Ty::Union { variants } => variants.iter().cloned().collect(),
+                t => vec![t],
+            };
+            let hash = arms.into_iter().find(|t| matches!(t, Ty::Hash { .. }))?;
+            let h_s = super::ty::crystal_ty(&hash);
+            Some(format!("{}.as({h_s}).merge({})", emit_expr(r), emit_as_rec(arg, &hash)))
+        }
+        _ => None,
+    }
+}
+
+/// A value headed into a container of the alias: a call into the
+/// component is cast to the alias (see `emit_do_block`).
+fn emit_rec_value(e: &Expr) -> String {
+    let s = emit_expr(e);
+    if let ExprNode::Send { recv, method, block: None, .. } = &*e.node {
+        if let Some(alias) = rec_ret_alias(recv.as_ref(), method) {
+            return format!("{s}.as({})", super::ty::crystal_ty(&alias));
+        }
+    }
+    s
+}
+
+/// Recursive emission (`RH_EMIT_REC=1`): the alias a self-call returns, when
+/// the callee is in a recursive component.
+fn rec_ret_alias(recv: Option<&Expr>, method: &Symbol) -> Option<Ty> {
+    let self_call = recv.is_none_or(|r| matches!(&*r.node, ExprNode::SelfRef));
+    if !self_call || !crate::analyze::rec_alias::on() {
+        return None;
+    }
+    let class = REC_CLASS.with(|c| c.borrow().clone())?;
+    crate::analyze::rec_alias::ret_alias(&crate::ident::ClassId(class), method)
+}
+
+/// Recursive emission (`RH_EMIT_REC=1`): emit `e` where `expected` is wanted.
+/// Crystal's generics are invariant, so a literal container headed for a
+/// recursive alias is built as the alias' own Hash or Array arm (an `of`
+/// clause, element by element); anything else is emitted as is, and
+/// Crystal checks that it fits.
+fn emit_as_rec(e: &Expr, expected: &Ty) -> String {
+    let arms: Vec<Ty> = match crate::analyze::rec_alias::body_of(expected) {
+        Some(Ty::Union { variants }) => variants.iter().cloned().collect(),
+        Some(t) => vec![t],
+        None if crate::analyze::rec_alias::mentions_alias(expected) => vec![expected.clone()],
+        None => return emit_expr(e),
+    };
+    match &*e.node {
+        ExprNode::Hash { entries, .. } => {
+            if let Some(Ty::Hash { key, value }) = arms.iter().find(|t| matches!(t, Ty::Hash { .. })) {
+                let parts: Vec<String> = entries
+                    .iter()
+                    .map(|(k, v)| format!("{} => {}", emit_as_rec(k, key), emit_as_rec(v, value)))
+                    .collect();
+                let (k_s, v_s) = (super::ty::crystal_ty(key), super::ty::crystal_ty(value));
+                return format!("({{{}}} of {k_s} => {v_s})", parts.join(", "));
+            }
+        }
+        ExprNode::Array { elements, .. } => {
+            if let Some(Ty::Array { elem }) = arms.iter().find(|t| matches!(t, Ty::Array { .. })) {
+                let parts: Vec<String> = elements.iter().map(|x| emit_as_rec(x, elem)).collect();
+                return format!("([{}] of {})", parts.join(", "), super::ty::crystal_ty(elem));
+            }
+        }
+        _ => {}
+    }
+    emit_expr(e)
+}
