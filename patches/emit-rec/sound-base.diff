+                    }
+                }
+                Ty::Untyped => {
+                    k = union_of(k, Ty::Untyped);
+                    v = union_of(v, Ty::Untyped);
+                }
+                _ => {}
+            }
+        }
+    }
+    if let Some(r) = block_ret {
+        v = union_of(v, r.clone());
+    }
+    Ty::Hash { key: std::sync::Arc::new(k), value: std::sync::Arc::new(v) }
