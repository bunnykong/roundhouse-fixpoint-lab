+#[cfg(test)]
+mod model_tests {
+    //! The Rust port against regular's model (`fold_model.py`, `fold_model.out`):
+    //! the same shapes, the `fold` policy and the side-table step with an identity cut
+    //! (`fold-side1`), checked for rounds and for the exact regular solution.
+    use super::*;
+
+    const BOT_ONLY: Bot = Bot::Mask(1);
+
+    struct T {
+        i: Interner,
+        str_: TyId,
+        int: TyId,
+        sym: TyId,
+        nil: TyId,
+        bot: TyId,
+    }
+
+    impl T {
+        fn new() -> Self {
+            let mut i = Interner::new();
+            let str_ = i.leaf(&Ty::Str);
+            let int = i.leaf(&Ty::Int);
+            let sym = i.leaf(&Ty::Sym);
+            let nil = i.leaf(&Ty::Nil);
+            let bot = i.leaf(&Ty::Bottom);
+            T { i, str_, int, sym, nil, bot }
+        }
+        fn u(&mut self, ts: &[TyId]) -> TyId {
+            self.i.union_many(ts)
+        }
+        fn select(&self, x: TyId, sel: u8) -> Vec<u32> {
+            let nodes = &self.i.reg(x).nodes;
+            let mut out = Vec::new();
+            for a in arms_of(nodes, 0) {
+                match (&nodes[a as usize], sel) {
+                    (Node::Hash([_, v]), b'v') => out.push(*v),
+                    (Node::Hash([k, _]), b'k') => out.push(*k),
+                    (Node::Array([c]), b'e') => out.push(*c),
+                    _ => {}
+                }
+            }
+            out
+        }
+        fn proj(&mut self, x: TyId, sel: u8) -> TyId {
+            let kids = self.select(x, sel);
+            let parts: Vec<TyId> = kids.into_iter().map(|c| self.i.sub(x, c)).collect();
+            if parts.is_empty() { self.bot } else { self.u(&parts) }
+        }
+        fn leaves(&mut self, x: TyId) -> TyId {
+            let nodes = self.i.reg(x).nodes.clone();
+            let mut parts = Vec::new();
+            for a in arms_of(&nodes, 0) {
+                if let Node::Leaf(l) = &nodes[a as usize] {
+                    if *l != self.i.bot {
+                        let s = self.i.sub(x, a);
+                        parts.push(s);
+                    }
+                }
+            }
+            if parts.is_empty() { self.bot } else { self.u(&parts) }
+        }
+        fn merge(&mut self, x: TyId, y: TyId) -> TyId {
+            if self.select(x, b'k').is_empty() {
+                return self.bot;
+            }
+            let (kx, ky, vx, vy) = (self.proj(x, b'k'), self.proj(y, b'k'), self.proj(x, b'v'), self.proj(y, b'v'));
+            let k = self.u(&[kx, ky]);
+            let v = self.u(&[vx, vy]);
+            self.i.hsh(k, v)
+        }
+    }
+
+    type Eqs = Vec<(&'static str, Box<dyn Fn(&mut T, &HashMap<&'static str, TyId>) -> TyId>)>;
+
+    fn shape(name: &str) -> Eqs {
+        let f = |t: &mut T, r: TyId| {
+            let a = t.i.arr(r);
+            let h = t.i.hsh(t.sym, r);
+            t.u(&[t.str_, a, h])
+        };
+        let g = |t: &mut T, r: TyId| {
+            let a = t.i.arr(r);
+            let h = t.i.hsh(t.str_, r);
+            t.u(&[t.int, a, h])
+        };
+        match name {
+            "self" => vec![("R", Box::new(move |t, s| f(t, s["R"])))],
+            "cycle2" => vec![("R0", Box::new(move |t, s| f(t, s["R1"]))), ("R1", Box::new(move |t, s| g(t, s["R0"])))],
+            "dhole" => vec![(
+                "R",
+                Box::new(|t, s| {
+                    let ri = t.u(&[s["R"], t.int]);
+                    let a = t.i.arr(ri);
+                    let h = t.i.hsh(t.sym, s["R"]);
+                    t.u(&[t.str_, a, h])
+                }),
+            )],
+            "f11" => vec![(
+                "R",
+                Box::new(|t, s| {
+                    let a = t.i.arr(s["R"]);
+                    let k = t.u(&[t.str_, t.sym]);
+                    let h = t.i.hsh(k, s["R"]);
+                    let tp = t.i.tup(&[t.str_, s["R"]]);
+                    t.u(&[t.str_, a, h, tp])
+                }),
+            )],
+            "chain5" => vec![
+                ("F0", Box::new(|t, s| t.i.arr(s["F1"]))),
+                ("F1", Box::new(|t, s| t.i.arr(s["F2"]))),
+                ("F2", Box::new(|t, s| t.i.arr(s["F3"]))),
+                ("F3", Box::new(|t, s| t.i.arr(s["F4"]))),
+                ("F4", Box::new(|t, s| t.i.arr(s["F5"]))),
+                ("F5", Box::new(|t, _| t.int)),
+            ],
+            "f2" => vec![
+                (
+                    "R",
+                    Box::new(|t, s| {
+                        let p = s["P"];
+                        let hv = t.proj(p, b'v');
+                        let h = t.i.hsh(t.str_, hv);
+                        let e = t.proj(p, b'e');
+                        let a = t.i.arr(e);
+                        let l = t.leaves(p);
+                        t.u(&[h, a, l])
+                    }),
+                ),
+                (
+                    "P",
+                    Box::new(|t, s| {
+                        let (r, p) = (s["R"], s["P"]);
+                        let is = t.u(&[t.int, t.str_]);
+                        let ia = t.i.arr(is);
+                        let lit = t.i.hsh(t.str_, ia);
+                        let hi = t.i.hsh(t.str_, t.int);
+                        let m1 = t.merge(r, hi);
+                        let hn = t.i.hsh(t.str_, t.nil);
+                        let m2 = t.merge(r, hn);
+                        let am2 = t.i.arr(m2);
+                        let fv = t.u(&[m1, am2]);
+                        let fed = t.i.hsh(t.str_, fv);
+                        let hv = t.proj(p, b'v');
+                        let e = t.proj(p, b'e');
+                        t.u(&[lit, fed, hv, e])
+                    }),
+                ),
+            ],
+            _ => unreachable!(),
+        }
+    }
+
+    /// The model's `run(name, policy)` for `fold` (side = false) and `fold-side1` (side = true).
+    fn run(t: &mut T, name: &str, side: bool) -> (Option<usize>, HashMap<&'static str, TyId>, u64) {
+        let eqs = shape(name);
+        let mut state: HashMap<&'static str, TyId> = eqs.iter().map(|(e, _)| (*e, t.bot)).collect();
+        let mut hist: HashMap<&str, Vec<TyId>> = state.iter().map(|(e, v)| (*e, vec![*v])).collect();
+        let mut seen: HashMap<&str, HashSet<TyId>> = state.iter().map(|(e, v)| (*e, HashSet::from([*v]))).collect();
+        let mut acc: HashMap<&str, bool> = state.keys().map(|e| (*e, false)).collect();
+        let mut pending = acc.clone();
+        let mut backstops = 0u64;
+        // identity cuts as opaque leaves carrying the regular type (M2's marker)
+        let cut_leaf = |t: &mut T, id: TyId, st: u32| -> TyId {
+            let sub = t.i.sub(id, st);
+            t.i.leaf(&Ty::Class { id: ClassId(Symbol::from(format!("⟨cut {sub}⟩").as_str())), args: vec![] })
+        };
+        for r in 1..=40 {
+            let view: HashMap<&'static str, TyId> = if side {
+                let mut v = HashMap::new();
+                for (e, s) in &state {
+                    let ty = t.i.view(*s, 1, &mut |i, id, st| {
+                        let sub = i.sub(id, st);
+                        Ty::Class { id: ClassId(Symbol::from(format!("⟨cut {sub}⟩").as_str())), args: vec![] }
+                    });
+                    let _ = cut_leaf;
+                    v.insert(*e, t.i.from_ty(&ty, false).unwrap());
+                }
+                v
+            } else {
+                state.clone()
+            };
+            let mut nxt = HashMap::new();
+            for (e, f) in &eqs {
+                let mut n = f(t, &view);
+                let old = state[e];
+                if side {
+                    // resolve_cuts: replace each cut leaf by the regular type it carries
+                    n = resolve(t, n);
+                    if acc[e] && t.i.covers(old, n, BOT_ONLY) {
+                        n = old;
+                    }
+                }
+                if n != old {
+                    let (folded, did, _) = t.i.fold(n, &hist[e], BOT_ONLY);
+                    if did > 0 && (pending[e] || acc[e]) {
+                        n = folded;
+                        acc.insert(e, true);
+                    }
+                    pending.insert(e, did > 0);
+                    if n != old && (seen[e].contains(&n) || (acc[e] && !t.i.covers(n, old, BOT_ONLY))) {
+                        n = t.i.join(old, n).unwrap();
+                        acc.insert(e, true);
+                    }
+                    if !t.i.reg(n).cyclic && t.i.depth(n) > 8 {
+                        let (w, b) = t.i.widen_k(n, 3);
+                        backstops += b as u64;
+                        if b > 0 {
+                            n = w;
+                            acc.insert(e, true);
+                        }
+                    }
+                }
+                nxt.insert(*e, n);
+            }
+            if nxt == state {
+                return (Some(r - 1), state, backstops);
+            }
+            state = nxt;
+            for (e, v) in &state {
+                hist.get_mut(e).unwrap().push(*v);
+                seen.get_mut(e).unwrap().insert(*v);
+            }
+        }
+        (None, state, backstops)
+    }
+
+    fn resolve(t: &mut T, n: TyId) -> TyId {
+        let nodes = t.i.reg(n).nodes.to_vec();
+        let mut g: Vec<Node> = nodes.clone();
+        let mut changed = false;
+        for (idx, node) in nodes.iter().enumerate() {
+            if let Node::Leaf(l) = node {
+                if let Ty::Class { id, .. } = t.i.leaf_ty(*l).clone() {
+                    if let Some(rest) = id.0.as_str().strip_prefix("⟨cut ") {
+                        let sub: TyId = rest.trim_end_matches('⟩').parse().unwrap();
+                        let base = t.i.embed(&mut g, sub);
+                        g[idx] = Node::Union(vec![base].into_boxed_slice());
+                        changed = true;
+                    }
+                }
+            }
+        }
+        if !changed {
+            return n;
+        }
+        t.i.canon(g, 0).unwrap()
+    }
+
+    /// μX. String | Array[X] | Hash[Symbol, X]
+    fn mu_self(t: &mut T) -> TyId {
+        let s = t.i.leaf_of(&Ty::Str);
+        let y = t.i.leaf_of(&Ty::Sym);
+        t.i.canon(
+            vec![
+                Node::Union(vec![1, 2, 3].into_boxed_slice()),
+                Node::Leaf(s),
+                Node::Array([0]),
+                Node::Hash([4, 0]),
+                Node::Leaf(y),
+            ],
+            0,
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn self_folds_exactly_in_three_rounds() {
+        let mut t = T::new();
+        let want = mu_self(&mut t);
+        let (rounds, st, b) = run(&mut t, "self", false);
+        assert_eq!(rounds, Some(3));
+        assert_eq!(st["R"], want, "{}", t.i.show(st["R"]));
+        assert_eq!(b, 0);
+        let mut t = T::new();
+        let want = mu_self(&mut t);
+        let (rounds, st, _) = run(&mut t, "self", true);
+        assert_eq!(rounds, Some(3));
+        assert_eq!(st["R"], want, "{}", t.i.show(st["R"]));
+    }
+
+    #[test]
+    fn cycle2_folds_exactly_in_four_rounds() {
+        let mut t = T::new();
+        let (rounds, st, _) = run(&mut t, "cycle2", false);
+        assert_eq!(rounds, Some(4));
+        assert_eq!(t.i.reg(st["R0"]).states(), 9, "{}", t.i.show(st["R0"]));
+        assert!(t.i.reg(st["R0"]).cyclic);
+        // R0 = f(R1), R1 = g(R0): the fold is the regular solution, so one more step is a fixpoint
+        let f = shape("cycle2");
+        let m: HashMap<&'static str, TyId> = st.clone();
+        let r0 = f[0].1(&mut t, &m);
+        assert_eq!(r0, st["R0"]);
+    }
+
+    #[test]
+    fn dhole_folds_to_two_state_pattern() {
+        let mut t = T::new();
+        let (rounds, st, _) = run(&mut t, "dhole", false);
+        assert_eq!(rounds, Some(3));
+        let f = shape("dhole");
+        let m: HashMap<&'static str, TyId> = st.clone();
+        assert_eq!(f[0].1(&mut t, &m), st["R"], "{}", t.i.show(st["R"]));
+    }
+
+    #[test]
+    fn f11_tuple_shape_folds() {
+        let mut t = T::new();
+        let (rounds, st, _) = run(&mut t, "f11", false);
+        assert_eq!(rounds, Some(3));
+        let f = shape("f11");
+        let m: HashMap<&'static str, TyId> = st.clone();
+        assert_eq!(f[0].1(&mut t, &m), st["R"], "{}", t.i.show(st["R"]));
+    }
+
+    #[test]
+    fn f2_fold_and_identity_cut_match_the_model() {
+        for side in [false, true] {
+            let mut t = T::new();
+            let (rounds, st, b) = run(&mut t, "f2", side);
+            assert_eq!(rounds, Some(6), "side={side}");
+            assert_eq!(b, 0);
+            assert_eq!(t.i.reg(st["R"]).states(), 8, "side={side}: {}", t.i.show(st["R"]));
+            assert_eq!(st["R"], st["P"], "side={side}");
+        }
+    }
+
+    #[test]
+    fn chain5_is_sound_but_not_exact() {
+        let mut t = T::new();
+        let (rounds, st, _) = run(&mut t, "chain5", false);
+        assert_eq!(rounds, Some(6));
+        assert!(t.i.reg(st["F0"]).cyclic, "{}", t.i.show(st["F0"]));
+    }
+
+    #[test]
+    fn lattice_laws_hold_on_a_sample() {
+        let mut t = T::new();
+        let mu = mu_self(&mut t);
+        let a = t.i.arr(t.str_);
+        let h = t.i.hsh(t.sym, t.int);
+        let u = t.u(&[t.str_, t.int]);
+        let mut st = run(&mut t, "cycle2", false).1;
+        let (r0, r1) = (st.remove("R0").unwrap(), st.remove("R1").unwrap());
+        let sample = [t.str_, t.int, a, h, u, mu, r0, r1];
+        for &x in &sample {
+            for &y in &sample {
+                let j = t.i.join(x, y).unwrap();
+                assert_eq!(j, t.i.join(y, x).unwrap());
+                assert!(t.i.covers(j, x, Bot::Rigid) && t.i.covers(j, y, Bot::Rigid));
+                assert_eq!(t.i.join(x, x).unwrap(), x);
+                if t.i.covers(x, y, Bot::Rigid) && t.i.covers(y, x, Bot::Rigid) {
+                    assert_eq!(x, y);
+                }
+                for &z in &sample {
+                    let l = t.i.join(j, z).unwrap();
+                    let r0 = t.i.join(y, z).unwrap();
+                    let r = t.i.join(x, r0).unwrap();
+                    assert_eq!(l, r);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn view_of_mu_is_m1_shape_and_round_trips() {
+        let mut t = T::new();
+        let mu = mu_self(&mut t);
+        let v = t.i.view(mu, 1, &mut |_, _, _| Ty::Untyped);
+        let want = Ty::Union {
+            variants: vec![
+                Ty::Str,
+                Ty::Array { elem: Box::new(Ty::Untyped) },
+                Ty::Hash { key: Box::new(Ty::Sym), value: Box::new(Ty::Untyped) },
+            ],
+        };
+        let mut w = Ty::Bottom;
+        for x in [want.clone()] {
+            w = crate::analyze::body::union_of(w, x);
+        }
+        assert_eq!(v, w);
+        let back = t.i.from_ty(&v, false).unwrap();
+        assert!(t.i.covers(mu, back, Bot::Bottom { untyped: true }));
+        assert_eq!(t.i.show_rbs(mu, "json"), "type json = Array[json] | Hash[Symbol, json] | String");
+    }
+}
+
+fn tree_nodes(t: &Ty) -> u64 {
+    1 + match t {
+        Ty::Array { elem } => tree_nodes(elem),
+        Ty::Hash { key, value } => tree_nodes(key) + tree_nodes(value),
+        Ty::Tuple { elems } => elems.iter().map(tree_nodes).sum(),
+        Ty::Record { row } => row.fields.values().map(tree_nodes).sum(),
+        Ty::Class { args, .. } => args.iter().map(tree_nodes).sum(),
+        Ty::Union { variants } => variants.iter().map(tree_nodes).sum(),
+        _ => 0,
+    }
+}
