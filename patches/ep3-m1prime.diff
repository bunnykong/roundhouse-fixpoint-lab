+pub(crate) fn loop_done(stage: &'static str, rounds: usize, capped: bool) {
+    with(|s| s.loops.push((stage, rounds, capped)));
+}
+
+impl State {
+    fn visible(&mut self, v: TyId) -> Ty {
+        self.int.view(v, 1, &mut |i, id, st| cut_ty(i, id, st))
+    }
+
+    /// The anonymous view of a stored value as a regular type (the typer embeds it).
+    fn view_reg(&mut self, v: TyId) -> Option<TyId> {
+        if let Some(&r) = self.view_cache.get(&v) {
+            return Some(r);
+        }
+        let t = self.int.view(v, 1, &mut |_, _, _| Ty::Untyped);
+        let r = self.int.from_ty(&t, false)?;
+        self.view_cache.insert(v, r);
+        Some(r)
+    }
+
+    fn store(&mut self, key: SlotKey, new: &Ty) -> Ty {
+        let t0 = Instant::now();
+        let mut slot = self.slots.remove(&key).unwrap_or_default();
+        let out = self.store_inner(&key, &mut slot, new);
+        self.slots.insert(key, slot);
+        self.nanos += t0.elapsed().as_nanos();
+        out
+    }
+
+    fn store_inner(&mut self, key: &SlotKey, slot: &mut Slot, new: &Ty) -> Ty {
+        self.c.stores += 1;
+        if let Some((raw, out)) = &slot.last_in {
+            if raw == new {
+                self.c.same += 1;
+                self.c.raw_hits += 1;
+                return out.clone();
+            }
+        }
+        let out = self.store_step(key, slot, new);
+        slot.last_in = Some((new.clone(), out.clone()));
+        out
+    }
+
+    fn store_step(&mut self, key: &SlotKey, slot: &mut Slot, new: &Ty) -> Ty {
+        let marker = *MODE == Mode::Marker;
+        let bot = bottom_mode();
+        let kind = key.kind;
+        if *TRACE {
+            /* Input-bearing debug probe omitted. */
+        }
+        let Some(n) = self.int.from_ty(new, marker) else {
+            self.c.conv_fail += 1;
+            if *TRACE {
+                /* Input-bearing debug probe omitted. */
+            }
+            return slot.visible.clone().unwrap_or_else(|| new.clone());
+        };
+        self.c.max_input_states = self.c.max_input_states.max(self.int.reg(n).states() as u64);
+        let trace = if *TRACE { Some(slot_label(key)) } else { None };
+        let Some(old) = slot.stored else {
+            slot.stored = Some(n);
+            slot.hist.push(n);
+            slot.seen.insert(n);
+            self.c.first += 1;
+            self.c.max_states = self.c.max_states.max(self.int.reg(n).states() as u64);
+            if let Some(k) = &trace {
+                /* Input-bearing debug probe omitted. */
+            }
+            if self.int.reg(n).cyclic {
+                // a resolved marker made it recursive: the typer reads its canonical view
+                let t = self.visible(n);
+                slot.visible = Some(t.clone());
+                return t;
+            }
+            return new.clone();
+        };
+        if n == old {
+            self.c.same += 1;
+            if let Some(k) = &trace {
+                /* Input-bearing debug probe omitted. */
+            }
+            // an unchanged regular type keeps its last view: the raw tree can be a deeper
+            // unrolling of the same type (markers re-embedded through other slots' views)
+            return if slot.acc || self.int.reg(old).cyclic {
+                slot.visible.clone().unwrap_or_else(|| new.clone())
+            } else {
+                new.clone()
+            };
+        }
+        if slot.acc && self.int.covers(old, n, bot) {
+            self.c.explained += 1;
+            if let Some(k) = &trace {
+                /* Input-bearing debug probe omitted. */
+            }
+            return slot.visible.clone().unwrap_or_else(|| new.clone());
+        }
+        self.c.changed += 1;
+        let mut hs = slot.hist.clone();
+        if slot.acc && !marker {
+            if let Some(vr) = self.view_reg(old) {
+                hs.push(vr);
+            }
+        }
+        let mut v = n;
+        let mut acc = slot.acc;
+        let mut note: Vec<String> = Vec::new();
+        let (folded, did, orph) = self.int.fold(v, &hs, bot);
+        self.c.orphans += orph as u64;
+        let mut fold_now = false;
+        if did > 0 && (slot.pending || slot.acc) {
+            v = folded;
+            acc = true;
+            fold_now = true;
+            self.c.folds[kind.idx()] += did as u64;
+            self.c.fold_events[kind.idx()] += 1;
+            note.push(format!("fold×{did}"));
+        } else if did > 0 {
+            self.c.pending_witness += 1;
+            note.push("witness(pending)".into());
+        }
+        let pending = did > 0;
+        // a revisit, or a non-monotone step on an accumulating entry: join
+        let revisit = slot.seen.contains(&v);
+        if v != old && (revisit || (acc && !self.int.covers(v, old, bot))) {
+            let Some(j) = self.int.join(old, v) else {
+                // canonicalization over budget: keep the stored value (counted in canon_fail)
+                return slot.visible.clone().unwrap_or_else(|| new.clone());
+            };
+            if revisit {
+                self.c.revisits += 1;
+            } else {
+                self.c.nonmonotone += 1;
+            }
+            if j != v {
+                self.c.joins += 1;
+            }
+            v = j;
+            acc = true;
+            note.push(if revisit { "join(revisit)".into() } else { "join(nonmonotone)".into() });
+        }
+        // T3's (A2): the backstop fires whenever the value's constructor depth (back edges
+        // excluded) exceeds D, cyclic or not. The model's code guards it with `not cyclic()`,
+        // which lets a folded value keep growing below its cycles (f2 in the real typer).
+        if (*BACKSTOP_CYCLIC || !self.int.reg(v).cyclic) && self.int.depth(v) > BACKSTOP_DEPTH {
+            let (w, b) = self.int.widen_k(v, BACKSTOP_K);
+            if b > 0 {
+                self.c.backstop_firings += b as u64;
+                self.c.backstop_events += 1;
+                v = w;
+                acc = true;
+                note.push(format!("backstop×{b}"));
+            }
+        }
+        // T3 makes the k-truncation range finite, but N_3 is astronomically large: a value
+        // can keep thousands of states. Past `RH_EP3_STATES` states (default 256) the
+        // backstop escalates to coarser truncations, k = 2 then 1, which bounds the states
+        // by the distinct heads. Counted separately; it is the size bound of this design.
+        let mut k = BACKSTOP_K;
+        while self.int.reg(v).states() > *STATE_CAP && k > 1 {
+            k -= 1;
+            let (w, b) = self.int.widen_k(v, k);
+            if b > 0 {
+                self.c.escalations += 1;
+                self.c.backstop_firings += b as u64;
+                v = w;
+                acc = true;
+                note.push(format!("escalate(k={k})×{b}"));
+            }
+        }
+        if slot.folds > 0 && v != old {
+            self.c.post_fold_changes += 1;
+        }
+        self.c.max_states = self.c.max_states.max(self.int.reg(v).states() as u64);
+        if let Some(k) = &trace {
+            /* Input-bearing debug probe omitted. */
+        }
+        slot.stored = Some(v);
+        if slot.hist.last() != Some(&v) {
+            slot.hist.push(v);
+        }
+        slot.seen.insert(v);
+        slot.acc = acc;
+        slot.pending = pending;
+        if fold_now {
+            slot.folds += 1;
+        }
+        if acc || self.int.reg(v).cyclic {
+            let t = self.visible(v);
+            if *TRACE {
+                /* Input-bearing debug probe omitted. */
+            }
+            slot.visible = Some(t.clone());
+            t
+        } else {
+            slot.visible = None;
+            new.clone()
+        }
+    }
+}
+
+fn slot_label(key: &SlotKey) -> String {
+    format!(
+        "{} {}#{}[{}]{}",
+        key.kind.name(),
+        key.owner.0.as_str(),
+        key.name.as_str(),
+        key.index,
+        key.ivar.as_ref().map(|i| format!("@{}", i.as_str())).unwrap_or_default()
+    )
+}
+
+/// Methods on a cycle of the recorded call graph (non-trivial SCC or self-loop): Tarjan.
+fn cyclic_methods(edges: &HashSet<((ClassId, Symbol), (ClassId, Symbol))>) -> HashSet<(ClassId, Symbol)> {
+    let mut ids: HashMap<&(ClassId, Symbol), usize> = HashMap::new();
+    let mut names: Vec<&(ClassId, Symbol)> = Vec::new();
+    let mut adj: Vec<Vec<usize>> = Vec::new();
+    let mut self_loop: HashSet<usize> = HashSet::new();
+    let mut sorted: Vec<&((ClassId, Symbol), (ClassId, Symbol))> = edges.iter().collect();
+    sorted.sort();
+    for (a, b) in sorted.iter().map(|e| (&e.0, &e.1)) {
+        for k in [a, b] {
+            if !ids.contains_key(k) {
+                ids.insert(k, names.len());
+                names.push(k);
+                adj.push(Vec::new());
+            }
+        }
+        let (ia, ib) = (ids[a], ids[b]);
+        if ia == ib {
+            self_loop.insert(ia);
+        }
+        adj[ia].push(ib);
+    }
+    let n = names.len();
+    let (mut index, mut low, mut on) = (vec![usize::MAX; n], vec![0usize; n], vec![false; n]);
+    let mut stack: Vec<usize> = Vec::new();
+    let mut counter = 0usize;
+    let mut out: HashSet<(ClassId, Symbol)> = HashSet::new();
+    for s in 0..n {
+        if index[s] != usize::MAX {
+            continue;
+        }
+        // iterative Tarjan: frames of (node, next edge)
+        let mut frames: Vec<(usize, usize)> = vec![(s, 0)];
+        index[s] = counter;
+        low[s] = counter;
+        counter += 1;
+        stack.push(s);
+        on[s] = true;
+        while let Some(&mut (v, ref mut ei)) = frames.last_mut() {
+            if *ei < adj[v].len() {
+                let w = adj[v][*ei];
+                *ei += 1;
+                if index[w] == usize::MAX {
+                    index[w] = counter;
+                    low[w] = counter;
+                    counter += 1;
+                    stack.push(w);
+                    on[w] = true;
+                    frames.push((w, 0));
+                } else if on[w] {
+                    low[v] = low[v].min(index[w]);
+                }
+            } else {
+                frames.pop();
+                if let Some(&(p, _)) = frames.last() {
+                    low[p] = low[p].min(low[v]);
+                }
+                if low[v] == index[v] {
+                    let mut comp = Vec::new();
+                    loop {
+                        let w = stack.pop().unwrap();
+                        on[w] = false;
+                        comp.push(w);
+                        if w == v {
+                            break;
+                        }
+                    }
+                    if comp.len() > 1 || self_loop.contains(&v) {
+                        for w in comp {
+                            out.insert(names[w].clone());
+                        }
+                    }
+                }
+            }
+        }
+    }
+    out
+}
+
+/// End of `Analyzer::analyze`: one aggregate record on stderr (numbers only, no names), and
+/// with `RH_EP3_PRINT` the RBS aliases of every folded slot (public inputs only).
+pub(crate) fn end() {
+    let Some(Some(st)) = (if on() { Some(STATE.with(|s| s.borrow_mut().take())) } else { None }) else { return };
+    let cyc = cyclic_methods(&st.edges);
+    let (mut folded_slots, mut folded_in_cycle, mut folded_outside, mut folded_ivar) = (0u64, 0u64, 0u64, 0u64);
+    let (mut acc_slots, mut cyclic_slots) = (0u64, 0u64);
+    let mut by_kind_slots = [0u64; 4];
+    for (k, s) in &st.slots {
+        if s.acc {
+            acc_slots += 1;
+        }
+        if s.stored.is_some_and(|v| st.int.reg(v).cyclic) {
+            cyclic_slots += 1;
+        }
+        by_kind_slots[k.kind.idx()] += 1;
+        if s.folds > 0 {
+            folded_slots += 1;
+            match k.kind {
+                SlotKind::Ivar => folded_ivar += 1,
+                _ if cyc.contains(&(k.owner.clone(), k.name.clone())) => folded_in_cycle += 1,
+                _ => folded_outside += 1,
+            }
+        }
+    }
+    let (t1_checked, t1_violations) = FOLD_CHECKS.with(|c| *c.borrow());
+    let view_budget = VIEW_BUDGET.with(|v| *v.borrow());
+    let loops: Vec<serde_json::Value> = st
+        .loops
+        .iter()
+        .map(|(stage, rounds, capped)| serde_json::json!({"stage": stage, "rounds": rounds, "capped": capped}))
+        .collect();
+    let c = &st.c;
+    let mut m = serde_json::Map::new();
+    let mut put = |k: &str, v: serde_json::Value| {
+        m.insert(k.to_string(), v);
+    };
+    use serde_json::json;
+    put("seq", json!(st.seq));
+    put("mode", json!(match *MODE { Mode::Anon => "anon", Mode::Marker => "marker", Mode::Off => "off" }));
+    put("seed", json!("var"));
+    put("untyped_bottom", json!(!*UNTYPED_RIGID));
+    put("cap", json!(CAP.unwrap_or(12)));
+    put("slots", json!(st.slots.len()));
+    put("slots_by_kind", json!(by_kind_slots));
+    put("stores", json!(c.stores));
+    put("first", json!(c.first));
+    put("same", json!(c.same));
+    put("explained", json!(c.explained));
+    put("changed", json!(c.changed));
+    put("folds_by_kind", json!(c.folds));
+    put("fold_events_by_kind", json!(c.fold_events));
+    put("folded_slots", json!(folded_slots));
+    put("folded_in_call_cycle", json!(folded_in_cycle));
+    put("folded_outside_call_cycle", json!(folded_outside));
+    put("folded_ivar", json!(folded_ivar));
+    put("pending_witness", json!(c.pending_witness));
+    put("orphans", json!(c.orphans));
+    put("joins", json!(c.joins));
+    put("revisits", json!(c.revisits));
+    put("nonmonotone", json!(c.nonmonotone));
+    put("backstop_firings", json!(c.backstop_firings));
+    put("backstop_events", json!(c.backstop_events));
+    put("post_fold_changes", json!(c.post_fold_changes));
+    put("conv_fail", json!(c.conv_fail));
+    put("accumulating_slots", json!(acc_slots));
+    put("cyclic_slots", json!(cyclic_slots));
+    put("max_states", json!(c.max_states));
+    put("max_input_states", json!(c.max_input_states));
+    put("unfolds", json!(c.unfolds));
+    put("raw_hits", json!(c.raw_hits));
+    put("escalations", json!(c.escalations));
+    put("loops", serde_json::Value::Array(loops));
+    put("call_graph_edges", json!(st.edges.len()));
+    put("cyclic_methods", json!(cyc.len()));
+    put("interned", json!(st.int.regs.len()));
+    put("canon_calls", json!(st.int.stats.canon_calls));
+    put("canon_ms", json!((st.int.stats.canon_nanos / 1_000_000) as u64));
+    put("canon_fail", json!(st.int.stats.canon_fail));
+    put("max_det_states", json!(st.int.stats.max_det_states));
+    put("sim_calls", json!(st.int.stats.sim_calls));
+    put("ep3_ms", json!((st.nanos / 1_000_000) as u64));
+    put("t1_checked", json!(t1_checked));
+    put("t1_violations", json!(t1_violations));
+    put("view_budget", json!(view_budget));
+    let rec = serde_json::Value::Object(m);
+    eprintln!("rh-ep3: {rec}");
+    if let Ok(path) = std::env::var("RH_EP3_PRINT") {
+        let mut keys: Vec<&SlotKey> = st.slots.keys().collect();
+        keys.sort();
+        let mut out = String::new();
+        out.push_str(&format!("# rh-ep3 analysis {} mode {:?}\n", st.seq, *MODE));
+        for k in keys {
+            let s = &st.slots[k];
+            let Some(v) = s.stored else { continue };
+            let name = alias_name(k);
+            out.push_str(&format!(
+                "# {} folds={} states={} cyclic={} in_call_cycle={}\n",
+                slot_label(k),
+                s.folds,
+                st.int.reg(v).states(),
+                st.int.reg(v).cyclic,
+                cyc.contains(&(k.owner.clone(), k.name.clone()))
+            ));
+            out.push_str(&format!("# mu: {}\n", st.int.show(v)));
+            out.push_str(&st.int.show_rbs(v, &name));
+            out.push('\n');
+        }
+        use std::io::Write;
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+            let _ = f.write_all(out.as_bytes());
+        }
+    }
+}
+
+fn alias_name(k: &SlotKey) -> String {
+    let base: String = k
+        .name
+        .as_str()
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c.to_ascii_lowercase() } else { '_' })
+        .collect();
+    let base = base.trim_matches('_').to_string();
+    match k.kind {
+        SlotKind::Ret | SlotKind::CRet => base,
+        SlotKind::Param => format!("{base}_p{}", k.index),
+        SlotKind::Ivar => format!(
+            "{base}_{}",
+            k.ivar.as_ref().map(|s| s.as_str().trim_start_matches('@').to_string()).unwrap_or_default()
+        ),
+    }
+}
