+const BACKSTOP_DEPTH: u32 = 8;
+const BACKSTOP_K: u32 = 3;
+static STATE_CAP: LazyLock<usize> =
+    LazyLock::new(|| std::env::var("RH_EP3_STATES").ok().and_then(|s| s.parse().ok()).unwrap_or(256));
+static BACKSTOP_CYCLIC: LazyLock<bool> = LazyLock::new(|| std::env::var("RH_EP3_BACKSTOP").map_or(true, |v| v != "acyclic"));
+
+static UNTYPED_RIGID: LazyLock<bool> =
+    LazyLock::new(|| std::env::var("RH_EP3_UNTYPED").is_ok_and(|v| v == "rigid"));
+
+fn bottom_mode() -> Bot {
+    // ⊥ and `Var` (Roundhouse's "not computed yet": a not-yet-harvested callee types as
+    // `Var(0)`) are below everything. `Untyped` is too by default, as NOTE M1′ specifies
+    // ("the stored type covers the output with Untyped as bottom"): it is the anonymous
+    // cut, and register_method_return seeds untypeable bodies with it. With
+    // `RH_EP3_UNTYPED=rigid` (meaningful with the M2 marker only) `Untyped` is an authored
+    // gradual leaf and only ⊥/`Var` are pending: the two roles split.
+    Bot::Bottom { untyped: !*UNTYPED_RIGID }
+}
+
+/// Start of `Analyzer::analyze`: a fresh side table.
+pub(crate) fn begin() {
+    if !on() {
+        return;
+    }
+    let seq = SEQ.with(|s| {
+        *s.borrow_mut() += 1;
+        *s.borrow()
+    });
+    FOLD_CHECKS.with(|c| *c.borrow_mut() = (0, 0));
+    VIEW_BUDGET.with(|v| *v.borrow_mut() = 0);
+    STATE.with(|st| {
+        *st.borrow_mut() = Some(State {
+            int: Interner::new(),
+            slots: HashMap::new(),
+            c: Counters::default(),
+            edges: HashSet::new(),
+            loops: Vec::new(),
+            view_cache: HashMap::new(),
+            nanos: 0,
+            seq,
+            round: 0,
+        })
+    });
+}
+
+pub(crate) fn with<R>(f: impl FnOnce(&mut State) -> R) -> Option<R> {
+    if !on() {
+        return None;
+    }
+    STATE.with(|st| st.borrow_mut().as_mut().map(f))
+}
+
+/// The store step at a handoff: returns the value the typer should see next round.
+pub(crate) fn store(key: SlotKey, new: &Ty) -> Ty {
+    with(|s| s.store(key, new)).unwrap_or_else(|| new.clone())
+}
+
+pub(crate) fn edge(from: (&ClassId, &Symbol), to: (&ClassId, &Symbol)) {
+    with(|s| {
+        s.edges.insert(((from.0.clone(), from.1.clone()), (to.0.clone(), to.1.clone())));
+    });
+}
+
+/// One numeric line per round (after the round's unify step): how the side table moves.
+pub(crate) fn round_mark() {
+    with(|s| {
+        s.round += 1;
+        let total_states: u64 = s.slots.values().filter_map(|x| x.stored).map(|v| s.int.reg(v).states() as u64).sum();
+        eprintln!(
+            "rh-ep3-round: {{\"round\":{},\"stores\":{},\"changed\":{},\"explained\":{},\"folds\":{},\"joins\":{},\"backstop_firings\":{},\"unfolds\":{},\"interned\":{},\"canon_calls\":{},\"max_states\":{},\"slot_states\":{},\"ep3_ms\":{}}}",
+            s.round,
+            s.c.stores,
+            s.c.changed,
+            s.c.explained,
+            s.c.folds.iter().sum::<u64>(),
+            s.c.joins,
+            s.c.backstop_firings,
+            s.c.unfolds,
+            s.int.regs.len(),
+            s.int.stats.canon_calls,
+            s.c.max_states,
+            total_states,
+            s.nanos / 1_000_000
+        );
+    });
+}
