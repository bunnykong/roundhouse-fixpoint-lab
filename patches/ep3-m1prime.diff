@@ -0,0 +1,2427 @@
+//! EP3 (pending Q8, prototype): fold self-containing unfoldings at the round-to-round
+//! handoffs into exact recursive types, held in an analysis-local side table of interned,
+//! canonical regular types. The typer keeps reading plain `Ty`: it sees `view_1` of the
+//! stored μ-type, with a marker at each cut.
+//!
+//! Gate: `RH_EP3` unset (or `0`) leaves the analyzer exactly as main. `RH_EP3=1` is M1′
+//! (the cut is a plain `Untyped`, the anonymous cut). Knobs, all inert without the gate:
+//! `RH_EP3_CAP=N` (fixpoint round cap), `RH_EP3_PRINT=FILE` (RBS aliases for folded slots;
+//! public inputs only, names appear), `RH_EP3_TRACE=1` (per-store trace on stderr; public
+//! inputs only), `RH_EP3_UNTYPED=rigid` (only ⊥ and `Var` are pending; `Untyped` is an
+//! authored leaf), `RH_EP3_BACKSTOP=acyclic` (the model's guard: never widen a cyclic value).
+//!
+//! Port of `models/fold_model.py` (Reg, canonicalize, covers, join, fold,
+//! widen_k, view, resolve_cuts); departures are listed in prototype the experiment notes.
+//!
+//! Representation (NOTE §6.1, encoding 2): a regular type is a node table, root 0,
+//! DFS-numbered after subset construction (union = choice; one Array and one Hash spine per
+//! union, as `union_of`; Tuple, Record and Class-with-args arms are kept apart, as
+//! `union_of` keeps them) and canonical Moore minimization. Tables are interned, so a
+//! `TyId` comparison is type equality.
+
+use std::cell::RefCell;
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::sync::LazyLock;
+use std::time::Instant;
+
+use crate::ident::{ClassId, Symbol, TyVar};
+use crate::ty::{Row, Ty};
+
+pub(crate) type TyId = u32;
+const NONE: u32 = u32::MAX;
+
+// ---------------------------------------------------------------------------- gate
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Mode {
+    Off,
+    /// M1′: the typer sees `Untyped` at the cut.
+    Anon,
+    /// M2: the typer sees a marker carrying the regular type at the cut.
+    Marker,
+}
+
+pub(crate) static MODE: LazyLock<Mode> = LazyLock::new(|| match std::env::var("RH_EP3").ok().as_deref() {
+    None | Some("") | Some("0") => Mode::Off,
+    Some("2") | Some("m2") | Some("marker") => {
+        if marker_supported() {
+            Mode::Marker
+        } else {
+            eprintln!("rh-ep3: RH_EP3=2 needs the M2 build; running M1′ (anonymous cut)");
+            Mode::Anon
+        }
+    }
+    _ => Mode::Anon,
+});
+
+pub(crate) fn on() -> bool {
+    *MODE != Mode::Off
+}
+
+static CAP: LazyLock<Option<usize>> =
+    LazyLock::new(|| std::env::var("RH_EP3_CAP").ok().and_then(|s| s.parse().ok()));
+static TRACE: LazyLock<bool> = LazyLock::new(|| std::env::var("RH_EP3_TRACE").is_ok_and(|v| v == "1"));
+
+/// The fixpoint round cap: main's, unless the gate is on and `RH_EP3_CAP` overrides it.
+pub(crate) fn cap(default: usize) -> usize {
+    if on() { CAP.unwrap_or(default) } else { default }
+}
+
+
+// ---------------------------------------------------------------------------- nodes
+
+#[derive(Clone, PartialEq, Eq, Hash, Debug)]
+pub(crate) enum Node {
+    Leaf(u32),
+    Array([u32; 1]),
+    Hash([u32; 2]),
+    Tuple(Box<[u32]>),
+    Record(u32, Box<[u32]>),
+    Class(u32, Box<[u32]>),
+    Union(Box<[u32]>),
+}
+
+impl Node {
+    fn kids(&self) -> &[u32] {
+        match self {
+            Node::Leaf(_) => &[],
+            Node::Array(c) => c,
+            Node::Hash(c) => c,
+            Node::Tuple(c) | Node::Record(_, c) | Node::Class(_, c) | Node::Union(c) => c,
+        }
+    }
+
+    fn map(&self, f: &mut dyn FnMut(u32) -> u32) -> Node {
+        match self {
+            Node::Leaf(l) => Node::Leaf(*l),
+            Node::Array([c]) => Node::Array([f(*c)]),
+            Node::Hash([k, v]) => Node::Hash([f(*k), f(*v)]),
+            Node::Tuple(c) => Node::Tuple(c.iter().map(|x| f(*x)).collect()),
+            Node::Record(s, c) => Node::Record(*s, c.iter().map(|x| f(*x)).collect()),
+            Node::Class(i, c) => Node::Class(*i, c.iter().map(|x| f(*x)).collect()),
+            Node::Union(c) => Node::Union(c.iter().map(|x| f(*x)).collect()),
+        }
+    }
+
+    fn is_union(&self) -> bool {
+        matches!(self, Node::Union(_))
+    }
+
+    fn is_leaf(&self) -> bool {
+        matches!(self, Node::Leaf(_))
+    }
+
+    /// A constructor: under one, a sub-state is "guarded" (NOTE D6).
+    fn is_ctor(&self) -> bool {
+        !matches!(self, Node::Leaf(_) | Node::Union(_))
+    }
+}
+
+#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]
+pub(crate) enum LeafKey {
+    Simple(u8),
+    Relation(ClassId),
+    Var(u32),
+    Class(ClassId),
+    Opaque(String),
+}
+
+/// A head: the shape of a state without its children. Ordered structurally, so canonical
+/// numbering does not depend on interning order.
+#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]
+enum HeadKey {
+    Leaf(LeafKey),
+    Array,
+    Hash,
+    Tuple(u32),
+    Record(Vec<Symbol>, Option<u32>),
+    Class(ClassId, u32),
+    Union(u32),
+}
+
+/// What an arm of a union is, for "same arm set" (NOTE D6) and simulation matching.
+#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]
+enum ArmHead {
+    Leaf(u32),
+    Array,
+    Hash,
+    Tuple(u32),
+    Record(u32),
+    Class(u32, u32),
+}
+
+pub(crate) struct Reg {
+    pub nodes: Box<[Node]>,
+    pub parent: Box<[u32]>,
+    pub cyclic: bool,
+}
+
+impl Reg {
+    pub fn states(&self) -> usize {
+        self.nodes.len()
+    }
+
+}
+
+fn arms_of(nodes: &[Node], i: u32) -> Vec<u32> {
+    match &nodes[i as usize] {
+        Node::Union(a) => a.to_vec(),
+        _ => vec![i],
+    }
+}
+
+// ---------------------------------------------------------------------------- interner
+
+#[derive(Default, Clone, Debug)]
+pub(crate) struct Stats {
+    pub canon_calls: u64,
+    pub canon_nanos: u128,
+    pub canon_fail: u64,
+    pub sim_calls: u64,
+    pub max_det_states: u64,
+}
+
+pub(crate) struct Interner {
+    regs: Vec<Reg>,
+    index: HashMap<Box<[Node]>, TyId>,
+    leaves: Vec<(LeafKey, Ty)>,
+    /// per leaf: 1 = ⊥, 2 = `Var` (pending), 4 = `Untyped`; the bottom set of a cover check
+    leaf_class: Vec<u8>,
+    leaf_index: HashMap<LeafKey, u32>,
+    shapes: Vec<(Vec<Symbol>, Option<TyVar>)>,
+    shape_index: HashMap<(Vec<Symbol>, Option<TyVar>), u32>,
+    classes: Vec<ClassId>,
+    class_index: HashMap<ClassId, u32>,
+    pub bot: u32,
+    pub untyped: u32,
+    pub stats: Stats,
+    depth_memo: HashMap<TyId, u32>,
+    sub_memo: HashMap<(TyId, u32), TyId>,
+}
+
+const DET_BUDGET: usize = 250_000;
+static VIEW_NODES: LazyLock<i64> =
+    LazyLock::new(|| std::env::var("RH_EP3_VIEW").ok().and_then(|s| s.parse().ok()).unwrap_or(512));
+
+impl Interner {
+    pub fn new() -> Self {
+        let mut i = Interner {
+            regs: Vec::new(),
+            index: HashMap::new(),
+            leaves: Vec::new(),
+            leaf_class: Vec::new(),
+            leaf_index: HashMap::new(),
+            shapes: Vec::new(),
+            shape_index: HashMap::new(),
+            classes: Vec::new(),
+            class_index: HashMap::new(),
+            bot: 0,
+            untyped: 0,
+            stats: Stats::default(),
+            depth_memo: HashMap::new(),
+            sub_memo: HashMap::new(),
+        };
+        i.bot = i.leaf_of(&Ty::Bottom);
+        i.untyped = i.leaf_of(&Ty::Untyped);
+        i
+    }
+
+    pub fn reg(&self, id: TyId) -> &Reg {
+        &self.regs[id as usize]
+    }
+
+    fn leaf_key(t: &Ty) -> Option<LeafKey> {
+        Some(match t {
+            Ty::Int => LeafKey::Simple(0),
+            Ty::Float => LeafKey::Simple(1),
+            Ty::Bool => LeafKey::Simple(2),
+            Ty::Str => LeafKey::Simple(3),
+            Ty::Sym => LeafKey::Simple(4),
+            Ty::Date => LeafKey::Simple(5),
+            Ty::Time => LeafKey::Simple(6),
+            Ty::SelfInstance => LeafKey::Simple(13),
+            Ty::Untyped => LeafKey::Simple(17),
+            Ty::Bottom => LeafKey::Simple(18),
+            Ty::Nil => LeafKey::Simple(19),
+            Ty::Relation { of } => LeafKey::Relation(of.clone()),
+            Ty::Var { var } => LeafKey::Var(var.0),
+            Ty::Class { id, args } if args.is_empty() => LeafKey::Class(id.clone()),
+            Ty::Fn { .. } => LeafKey::Opaque(format!("{t:?}")),
+            _ => return None,
+        })
+    }
+
+    pub fn leaf_of(&mut self, t: &Ty) -> u32 {
+        let key = Self::leaf_key(t).expect("leaf");
+        if let Some(&i) = self.leaf_index.get(&key) {
+            return i;
+        }
+        let i = self.leaves.len() as u32;
+        self.leaves.push((key.clone(), t.clone()));
+        self.leaf_class.push(match t {
+            Ty::Bottom => 1,
+            Ty::Var { .. } => 2,
+            Ty::Untyped => 4,
+            _ => 0,
+        });
+        self.leaf_index.insert(key, i);
+        i
+    }
+
+    pub fn leaf_ty(&self, l: u32) -> &Ty {
+        &self.leaves[l as usize].1
+    }
+
+    fn shape_of(&mut self, row: &Row) -> u32 {
+        let key = (row.fields.keys().cloned().collect::<Vec<_>>(), row.rest);
+        if let Some(&i) = self.shape_index.get(&key) {
+            return i;
+        }
+        let i = self.shapes.len() as u32;
+        self.shapes.push(key.clone());
+        self.shape_index.insert(key, i);
+        i
+    }
+
+    fn class_of(&mut self, id: &ClassId) -> u32 {
+        if let Some(&i) = self.class_index.get(id) {
+            return i;
+        }
+        let i = self.classes.len() as u32;
+        self.classes.push(id.clone());
+        self.class_index.insert(id.clone(), i);
+        i
+    }
+
+    fn head_key(&self, n: &Node) -> HeadKey {
+        match n {
+            Node::Leaf(l) => HeadKey::Leaf(self.leaves[*l as usize].0.clone()),
+            Node::Array(_) => HeadKey::Array,
+            Node::Hash(_) => HeadKey::Hash,
+            Node::Tuple(c) => HeadKey::Tuple(c.len() as u32),
+            Node::Record(s, _) => {
+                let (f, r) = &self.shapes[*s as usize];
+                HeadKey::Record(f.clone(), r.map(|v| v.0))
+            }
+            Node::Class(i, c) => HeadKey::Class(self.classes[*i as usize].clone(), c.len() as u32),
+            Node::Union(c) => HeadKey::Union(c.len() as u32),
+        }
+    }
+
+    fn arm_head(n: &Node) -> ArmHead {
+        match n {
+            Node::Leaf(l) => ArmHead::Leaf(*l),
+            Node::Array(_) => ArmHead::Array,
+            Node::Hash(_) => ArmHead::Hash,
+            Node::Tuple(c) => ArmHead::Tuple(c.len() as u32),
+            Node::Record(s, _) => ArmHead::Record(*s),
+            Node::Class(i, c) => ArmHead::Class(*i, c.len() as u32),
+            Node::Union(_) => unreachable!("a union arm is never a union"),
+        }
+    }
+
+    // ------------------------------------------------------------------ canonicalize
+
+    /// Canonical interned form of the regular type rooted at `root` of graph `g` (any node
+    /// table: unions may nest, arms may repeat heads, ⊥ may appear as an arm).
+    pub fn canon(&mut self, g: Vec<Node>, root: u32) -> Option<TyId> {
+        let t0 = Instant::now();
+        self.stats.canon_calls += 1;
+        let r = self.canon_inner(g, root);
+        self.stats.canon_nanos += t0.elapsed().as_nanos();
+        if r.is_none() {
+            self.stats.canon_fail += 1;
+        }
+        r
+    }
+
+    fn canon_inner(&mut self, mut g: Vec<Node>, mut root: u32) -> Option<TyId> {
+        for _ in 0..8 {
+            let (h, r) = self.determinize(&g, root)?;
+            self.stats.max_det_states = self.stats.max_det_states.max(h.len() as u64);
+            let (q, qr, degenerate) = self.minimize(&h, r);
+            if !degenerate {
+                return Some(self.number(&q, qr));
+            }
+            g = q;
+            root = qr;
+        }
+        None
+    }
+
+    fn flatten(&self, g: &[Node], states: &[u32]) -> Vec<u32> {
+        let mut out = Vec::new();
+        let mut seen = HashSet::new();
+        let mut todo: Vec<u32> = states.to_vec();
+        while let Some(s) = todo.pop() {
+            if !seen.insert(s) {
+                continue;
+            }
+            match &g[s as usize] {
+                Node::Union(a) => todo.extend(a.iter().copied()),
+                Node::Leaf(l) if *l == self.bot => {}
+                _ => out.push(s),
+            }
+        }
+        out.sort_unstable();
+        out
+    }
+
+    /// Subset construction over the union-as-choice automaton: `union_of`'s spine merge
+    /// (one Array, one Hash per union, merged pointwise), leaves deduplicated, ⊥ dropped,
+    /// Tuple / Record / Class-with-args arms kept apart.
+    fn determinize(&self, g: &[Node], root: u32) -> Option<(Vec<Node>, u32)> {
+        let mut h: Vec<Node> = Vec::new();
+        let mut memo: HashMap<Vec<u32>, u32> = HashMap::new();
+        let mut work: Vec<(u32, Vec<u32>)> = Vec::new();
+        fn id_for(
+            this: &Interner,
+            g: &[Node],
+            raw: &[u32],
+            h: &mut Vec<Node>,
+            memo: &mut HashMap<Vec<u32>, u32>,
+            work: &mut Vec<(u32, Vec<u32>)>,
+        ) -> u32 {
+            let set = this.flatten(g, raw);
+            if let Some(&id) = memo.get(&set) {
+                return id;
+            }
+            let id = h.len() as u32;
+            h.push(Node::Leaf(NONE));
+            memo.insert(set.clone(), id);
+            work.push((id, set));
+            id
+        }
+        let r = id_for(self, g, &[root], &mut h, &mut memo, &mut work);
+        while let Some((id, set)) = work.pop() {
+            if h.len() > DET_BUDGET {
+                return None;
+            }
+            if set.is_empty() {
+                h[id as usize] = Node::Leaf(self.bot);
+                continue;
+            }
+            let mut leaves: Vec<u32> = Vec::new();
+            let mut arr: Vec<u32> = Vec::new();
+            let mut hk: Vec<u32> = Vec::new();
+            let mut hv: Vec<u32> = Vec::new();
+            let mut others: Vec<u32> = Vec::new();
+            let (mut has_arr, mut has_hash) = (false, false);
+            for &s in &set {
+                match &g[s as usize] {
+                    Node::Leaf(l) => {
+                        if !leaves.contains(l) {
+                            leaves.push(*l)
+                        }
+                    }
+                    Node::Array([c]) => {
+                        has_arr = true;
+                        arr.push(*c)
+                    }
+                    Node::Hash([k, v]) => {
+                        has_hash = true;
+                        hk.push(*k);
+                        hv.push(*v)
+                    }
+                    Node::Union(_) => unreachable!(),
+                    _ => others.push(s),
+                }
+            }
+            let mut built: Vec<Node> = Vec::new();
+            leaves.sort_unstable();
+            for l in leaves {
+                built.push(Node::Leaf(l));
+            }
+            if has_arr {
+                let c = id_for(self, g, &arr, &mut h, &mut memo, &mut work);
+                built.push(Node::Array([c]));
+            }
+            if has_hash {
+                let k = id_for(self, g, &hk, &mut h, &mut memo, &mut work);
+                let v = id_for(self, g, &hv, &mut h, &mut memo, &mut work);
+                built.push(Node::Hash([k, v]));
+            }
+            for s in others {
+                let node = g[s as usize].clone();
+                let mut f = |c: u32| id_for(self, g, &[c], &mut h, &mut memo, &mut work);
+                built.push(node.map(&mut f));
+            }
+            if built.len() == 1 {
+                h[id as usize] = built.pop().unwrap();
+            } else {
+                let mut ids = Vec::with_capacity(built.len());
+                for b in built {
+                    ids.push(h.len() as u32);
+                    h.push(b);
+                }
+                h[id as usize] = Node::Union(ids.into_boxed_slice());
+            }
+        }
+        Some((h, r))
+    }
+
+    /// Moore partition refinement with canonical class names (ranks of sorted signatures),
+    /// then the quotient. Returns (quotient table indexed by class, root class, degenerate):
+    /// degenerate when some union lost all but one arm to merging (re-run determinize).
+    fn minimize(&self, h: &[Node], r: u32) -> (Vec<Node>, u32, bool) {
+        // reachable states, dense
+        let mut order: Vec<u32> = Vec::new();
+        let mut dense: HashMap<u32, u32> = HashMap::new();
+        let mut todo = vec![r];
+        while let Some(s) = todo.pop() {
+            if dense.contains_key(&s) {
+                continue;
+            }
+            dense.insert(s, order.len() as u32);
+            order.push(s);
+            for &c in h[s as usize].kids() {
+                if !dense.contains_key(&c) {
+                    todo.push(c);
+                }
+            }
+        }
+        let n = order.len();
+        let kids: Vec<Vec<u32>> = order.iter().map(|&s| h[s as usize].kids().iter().map(|c| dense[c]).collect()).collect();
+        let is_union: Vec<bool> = order.iter().map(|&s| h[s as usize].is_union()).collect();
+        // initial classes: ranks of head keys
+        let heads: Vec<HeadKey> = order.iter().map(|&s| self.head_key(&h[s as usize])).collect();
+        let mut sorted: Vec<&HeadKey> = heads.iter().collect();
+        sorted.sort();
+        sorted.dedup();
+        let rank: HashMap<&HeadKey, u32> = sorted.iter().enumerate().map(|(i, k)| (*k, i as u32)).collect();
+        let mut cls: Vec<u32> = heads.iter().map(|k| rank[k]).collect();
+        let mut ncls = sorted.len();
+        loop {
+            let sigs: Vec<(u32, Vec<u32>)> = (0..n)
+                .map(|s| {
+                    let mut ch: Vec<u32> = kids[s].iter().map(|&c| cls[c as usize]).collect();
+                    if is_union[s] {
+                        ch.sort_unstable();
+                        ch.dedup();
+                    }
+                    (cls[s], ch)
+                })
+                .collect();
+            let mut uniq: Vec<&(u32, Vec<u32>)> = sigs.iter().collect();
+            uniq.sort();
+            uniq.dedup();
+            if uniq.len() == ncls {
+                break;
+            }
+            let rk: HashMap<&(u32, Vec<u32>), u32> = uniq.iter().enumerate().map(|(i, k)| (*k, i as u32)).collect();
+            cls = sigs.iter().map(|k| rk[k]).collect();
+            ncls = uniq.len();
+        }
+        let mut q: Vec<Option<Node>> = vec![None; ncls];
+        let mut degenerate = false;
+        for s in 0..n {
+            let c = cls[s] as usize;
+            if q[c].is_some() {
+                continue;
+            }
+            let node = &h[order[s] as usize];
+            let mapped = match node {
+                Node::Union(_) => {
+                    let mut a: Vec<u32> = kids[s].iter().map(|&k| cls[k as usize]).collect();
+                    a.sort_unstable();
+                    a.dedup();
+                    if a.len() < 2 {
+                        degenerate = true;
+                    }
+                    Node::Union(a.into_boxed_slice())
+                }
+                other => {
+                    let mut i = 0usize;
+                    let ks = &kids[s];
+                    other.map(&mut |_| {
+                        let v = cls[ks[i] as usize];
+                        i += 1;
+                        v
+                    })
+                }
+            };
+            q[c] = Some(mapped);
+        }
+        (q.into_iter().map(|x| x.unwrap()).collect(), cls[0], degenerate)
+    }
+
+    /// DFS numbering from the root (union arms in canonical class order), then intern.
+    fn number(&mut self, q: &[Node], root: u32) -> TyId {
+        let mut num: HashMap<u32, u32> = HashMap::new();
+        let mut seq: Vec<u32> = Vec::new();
+        let mut parent: Vec<u32> = Vec::new();
+        // iterative preorder: stack of (state, parent number, next child index)
+        let mut stack: Vec<(u32, usize)> = Vec::new();
+        num.insert(root, 0);
+        seq.push(root);
+        parent.push(NONE);
+        stack.push((root, 0));
+        while let Some(&mut (s, ref mut next)) = stack.last_mut() {
+            let ks = q[s as usize].kids();
+            if *next >= ks.len() {
+                stack.pop();
+                continue;
+            }
+            let c = ks[*next];
+            *next += 1;
+            if !num.contains_key(&c) {
+                let me = num[&s];
+                num.insert(c, seq.len() as u32);
+                seq.push(c);
+                parent.push(me);
+                stack.push((c, 0));
+            }
+        }
+        let nodes: Box<[Node]> = seq.iter().map(|&s| q[s as usize].map(&mut |c| num[&c])).collect();
+        if let Some(&id) = self.index.get(&nodes) {
+            return id;
+        }
+        let cyclic = is_cyclic(&nodes);
+        let id = self.regs.len() as TyId;
+        self.index.insert(nodes.clone(), id);
+        self.regs.push(Reg { nodes, parent: parent.into_boxed_slice(), cyclic });
+        id
+    }
+
+    // ------------------------------------------------------------------ constructors
+
+    pub fn leaf(&mut self, t: &Ty) -> TyId {
+        let l = self.leaf_of(t);
+        self.canon(vec![Node::Leaf(l)], 0).expect("leaf")
+    }
+
+    fn embed(&self, g: &mut Vec<Node>, id: TyId) -> u32 {
+        let base = g.len() as u32;
+        for n in self.regs[id as usize].nodes.iter() {
+            g.push(n.map(&mut |c| c + base));
+        }
+        base
+    }
+
+    pub fn arr(&mut self, t: TyId) -> TyId {
+        let mut g = Vec::new();
+        let r = self.embed(&mut g, t);
+        g.push(Node::Array([r]));
+        let root = g.len() as u32 - 1;
+        self.canon(g, root).expect("arr")
+    }
+
+    pub fn hsh(&mut self, k: TyId, v: TyId) -> TyId {
+        let mut g = Vec::new();
+        let rk = self.embed(&mut g, k);
+        let rv = self.embed(&mut g, v);
+        g.push(Node::Hash([rk, rv]));
+        let root = g.len() as u32 - 1;
+        self.canon(g, root).expect("hsh")
+    }
+
+    pub fn tup(&mut self, ts: &[TyId]) -> TyId {
+        let mut g = Vec::new();
+        let rs: Vec<u32> = ts.iter().map(|&t| self.embed(&mut g, t)).collect();
+        g.push(Node::Tuple(rs.into_boxed_slice()));
+        let root = g.len() as u32 - 1;
+        self.canon(g, root).expect("tup")
+    }
+
+    pub fn try_union(&mut self, ts: &[TyId]) -> Option<TyId> {
+        if ts.is_empty() {
+            return Some(self.leaf(&Ty::Bottom));
+        }
+        if ts.len() == 1 {
+            return Some(ts[0]);
+        }
+        let mut g = Vec::new();
+        let rs: Vec<u32> = ts.iter().map(|&t| self.embed(&mut g, t)).collect();
+        g.push(Node::Union(rs.into_boxed_slice()));
+        let root = g.len() as u32 - 1;
+        self.canon(g, root)
+    }
+
+    pub fn union_many(&mut self, ts: &[TyId]) -> TyId {
+        self.try_union(ts).expect("union")
+    }
+
+    /// `None` when canonicalization exceeds its budget (counted as `canon_fail`).
+    pub fn join(&mut self, a: TyId, b: TyId) -> Option<TyId> {
+        if a == b {
+            return Some(a);
+        }
+        self.try_union(&[a, b])
+    }
+
+    /// The regular type rooted at `state` of `id`.
+    pub fn sub(&mut self, id: TyId, state: u32) -> TyId {
+        if state == 0 {
+            return id;
+        }
+        let g: Vec<Node> = self.regs[id as usize].nodes.to_vec();
+        self.canon(g, state).expect("sub")
+    }
+
+    pub fn sub_cached(&mut self, id: TyId, state: u32) -> TyId {
+        if let Some(&r) = self.sub_memo.get(&(id, state)) {
+            return r;
+        }
+        let r = self.sub(id, state);
+        self.sub_memo.insert((id, state), r);
+        r
+    }
+
+    // ------------------------------------------------------------------ Ty conversion
+
+    /// `Ty` → canonical regular type. `resolve` maps an M2 marker to the regular type it
+    /// carries (the store step's `resolve_cuts`). Hash-conses while converting, so a tree
+    /// with heavy duplication becomes a small graph. `None` past the node budget.
+    pub fn from_ty(&mut self, t: &Ty, resolve: bool) -> Option<TyId> {
+        let mut g: Vec<Node> = Vec::new();
+        let mut memo: HashMap<Node, u32> = HashMap::new();
+        let mut budget: usize = 2_000_000;
+        let mut embedded: HashMap<TyId, u32> = HashMap::new();
+        let root = self.conv(t, resolve, &mut g, &mut memo, &mut budget, &mut embedded)?;
+        self.canon(g, root)
+    }
+
+    fn push_node(g: &mut Vec<Node>, memo: &mut HashMap<Node, u32>, n: Node) -> u32 {
+        if let Some(&i) = memo.get(&n) {
+            return i;
+        }
+        let i = g.len() as u32;
+        g.push(n.clone());
+        memo.insert(n, i);
+        i
+    }
+
+    fn conv(
+        &mut self,
+        t: &Ty,
+        resolve: bool,
+        g: &mut Vec<Node>,
+        memo: &mut HashMap<Node, u32>,
+        budget: &mut usize,
+        embedded: &mut HashMap<TyId, u32>,
+    ) -> Option<u32> {
+        if *budget == 0 {
+            return None;
+        }
+        *budget -= 1;
+        if let Some(id) = marker_of(t) {
+            if resolve {
+                // embed the carried regular type once per conversion (it is canonical)
+                if let Some(&r) = embedded.get(&id) {
+                    return Some(r);
+                }
+                let r = self.embed(g, id);
+                embedded.insert(id, r);
+                return Some(r);
+            }
+            let l = self.leaf_of(&Ty::Untyped);
+            return Some(Self::push_node(g, memo, Node::Leaf(l)));
+        }
+        let node = match t {
+            Ty::Array { elem } => Node::Array([self.conv(elem, resolve, g, memo, budget, embedded)?]),
+            Ty::Hash { key, value } => {
+                let k = self.conv(key, resolve, g, memo, budget, embedded)?;
+                let v = self.conv(value, resolve, g, memo, budget, embedded)?;
+                Node::Hash([k, v])
+            }
+            Ty::Tuple { elems } => {
+                let mut ks = Vec::with_capacity(elems.len());
+                for e in elems {
+                    ks.push(self.conv(e, resolve, g, memo, budget, embedded)?);
+                }
+                Node::Tuple(ks.into_boxed_slice())
+            }
+            Ty::Record { row } => {
+                let s = self.shape_of(row);
+                let mut ks = Vec::with_capacity(row.fields.len());
+                for v in row.fields.values() {
+                    ks.push(self.conv(v, resolve, g, memo, budget, embedded)?);
+                }
+                Node::Record(s, ks.into_boxed_slice())
+            }
+            Ty::Class { id, args } if !args.is_empty() => {
+                let c = self.class_of(id);
+                let mut ks = Vec::with_capacity(args.len());
+                for a in args {
+                    ks.push(self.conv(a, resolve, g, memo, budget, embedded)?);
+                }
+                Node::Class(c, ks.into_boxed_slice())
+            }
+            Ty::Union { variants } => {
+                let mut ks = Vec::with_capacity(variants.len());
+                for v in variants {
+                    ks.push(self.conv(v, resolve, g, memo, budget, embedded)?);
+                }
+                Node::Union(ks.into_boxed_slice())
+            }
+            leaf => Node::Leaf(self.leaf_of(leaf)),
+        };
+        Some(Self::push_node(g, memo, node))
+    }
+
+    /// `view_k`: unfold, taking each back edge at most k − 1 times along a path; the k-th
+    /// occurrence of a state on the path becomes the cut (`cut(id, state)`). Unions are
+    /// rebuilt with `union_of`, so the result is in Roundhouse's normal form. A view larger
+    /// than `budget` nodes cuts every state's second occurrence anywhere (DAG cut) instead.
+    pub fn view(&mut self, id: TyId, k: u32, cut: &mut dyn FnMut(&mut Interner, TyId, u32) -> Ty) -> Ty {
+        // `view_1` can be exponential in the states (every simple path is unfolded), and
+        // everything the typer reads it must also carry. The view is therefore kept under
+        // `RH_EP3_VIEW` nodes (default 512) by cutting at the deepest constructor depth that
+        // fits. With the identity cut (M2) the cut is lossless at the store; with the
+        // anonymous cut it is a precision loss, as any `Untyped` cut is.
+        // Choose the depth with a counting pass (no cut is materialized: an M2 cut interns
+        // the sub-automaton at the cut, which is not free), then build the view once.
+        let len = self.regs[id as usize].nodes.len();
+        let mut chosen = 1;
+        for depth in [u32::MAX, 8, 6, 4, 3, 2, 1] {
+            let mut on_path: Vec<u32> = vec![0; len];
+            let mut budget: i64 = *VIEW_NODES;
+            self.view_count(id, 0, k, &mut on_path, &mut budget, depth);
+            if budget >= 0 {
+                chosen = depth;
+                break;
+            }
+        }
+        if chosen != u32::MAX {
+            VIEW_BUDGET.with(|v| *v.borrow_mut() += 1);
+        }
+        let mut on_path: Vec<u32> = vec![0; len];
+        let mut budget: i64 = i64::MAX;
+        self.view_go(id, 0, k, &mut on_path, &mut budget, chosen, cut)
+    }
+
+    /// `view_go`'s node count, stopping once the budget is spent.
+    fn view_count(&self, id: TyId, i: u32, k: u32, on_path: &mut Vec<u32>, budget: &mut i64, depth: u32) {
+        *budget -= 1;
+        if *budget < 0 {
+            return;
+        }
+        let node = &self.regs[id as usize].nodes[i as usize];
+        if on_path[i as usize] >= k || (depth == 0 && node.is_ctor()) || node.is_leaf() {
+            return;
+        }
+        let depth = if node.is_ctor() { depth.saturating_sub(1) } else { depth };
+        on_path[i as usize] += 1;
+        let kids: Vec<u32> = node.kids().to_vec();
+        for c in kids {
+            self.view_count(id, c, k, on_path, budget, depth);
+            if *budget < 0 {
+                break;
+            }
+        }
+        on_path[i as usize] -= 1;
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn view_go(
+        &mut self,
+        id: TyId,
+        i: u32,
+        k: u32,
+        on_path: &mut Vec<u32>,
+        budget: &mut i64,
+        depth: u32,
+        cut: &mut dyn FnMut(&mut Interner, TyId, u32) -> Ty,
+    ) -> Ty {
+        *budget -= 1;
+        let node = self.regs[id as usize].nodes[i as usize].clone();
+        if on_path[i as usize] >= k || *budget < 0 || (depth == 0 && node.is_ctor()) {
+            return cut(self, id, i);
+        }
+        let depth = if node.is_ctor() { depth.saturating_sub(1) } else { depth };
+        on_path[i as usize] += 1;
+        let out = match &node {
+            Node::Leaf(l) => self.leaves[*l as usize].1.clone(),
+            Node::Array([c]) => Ty::Array { elem: Box::new(self.view_go(id, *c, k, on_path, budget, depth, cut)) },
+            Node::Hash([a, b]) => {
+                let key = self.view_go(id, *a, k, on_path, budget, depth, cut);
+                let value = self.view_go(id, *b, k, on_path, budget, depth, cut);
+                Ty::Hash { key: Box::new(key), value: Box::new(value) }
+            }
+            Node::Tuple(cs) => Ty::Tuple { elems: cs.iter().map(|c| self.view_go(id, *c, k, on_path, budget, depth, cut)).collect() },
+            Node::Record(s, cs) => {
+                let (names, rest) = self.shapes[*s as usize].clone();
+                let mut fields = indexmap::IndexMap::new();
+                for (name, c) in names.into_iter().zip(cs.iter()) {
+                    let v = self.view_go(id, *c, k, on_path, budget, depth, cut);
+                    fields.insert(name, v);
+                }
+                Ty::Record { row: Row { fields, rest } }
+            }
+            Node::Class(ci, cs) => {
+                let cid = self.classes[*ci as usize].clone();
+                Ty::Class { id: cid, args: cs.iter().map(|c| self.view_go(id, *c, k, on_path, budget, depth, cut)).collect() }
+            }
+            Node::Union(cs) => {
+                let mut acc = Ty::Bottom;
+                for c in cs.iter() {
+                    let t = self.view_go(id, *c, k, on_path, budget, depth, cut);
+                    acc = super::body::union_of(acc, t);
+                }
+                acc
+            }
+        };
+        on_path[i as usize] -= 1;
+        out
+    }
+
+    // ------------------------------------------------------------------ simulation
+
+    /// `a[i] ⊒ b[j]` (every tree of b[j] is a tree of a[i]). Leaves are rigid except, when
+    /// `bottom` is set, ⊥ (and with `untyped_bottom`, `Untyped`) in b, which sit below
+    /// everything. Coinductive; one visit per pair, with the existential choice over
+    /// unmerged same-head arms (Tuple, Record, Class) snapshotting the hypothesis set.
+    pub fn sim(&mut self, a: TyId, i: u32, b: TyId, j: u32, bottom: Bot) -> bool {
+        self.stats.sim_calls += 1;
+        let mut visited: HashSet<(u32, u32)> = HashSet::new();
+        let mask = bottom.mask();
+        let ra = &self.regs[a as usize];
+        let rb = &self.regs[b as usize];
+        sim_go(&ra.nodes, &rb.nodes, i, j, mask, &self.leaf_class, &mut visited)
+    }
+
+    pub fn covers(&mut self, a: TyId, b: TyId, bottom: Bot) -> bool {
+        a == b || self.sim(a, 0, b, 0, bottom)
+    }
+
+    /// The arm heads of a state, leaving out leaves in the bottom set (`mask`): a pending
+    /// `Var`, ⊥, or (anonymous cut) `Untyped` is not part of a state's pattern.
+    fn arm_heads(&self, id: TyId, i: u32, mask: u8) -> Vec<ArmHead> {
+        let nodes = &self.regs[id as usize].nodes;
+        let mut v: Vec<ArmHead> = arms_of(nodes, i)
+            .into_iter()
+            .filter(|&a| !matches!(&nodes[a as usize], Node::Leaf(l) if self.leaf_class[*l as usize] & mask != 0))
+            .map(|a| Self::arm_head(&nodes[a as usize]))
+            .collect();
+        v.sort();
+        v.dedup();
+        v
+    }
+
+    fn compound(&self, id: TyId) -> bool {
+        !self.regs[id as usize].nodes[0].is_leaf()
+    }
+
+    // ------------------------------------------------------------------ the fold
+
+    /// NOTE D6: redirect every guarded sub-state that rigidly covers a compound value of the
+    /// history to its nearest ancestor that covers it (seed as bottom) with the same arm set.
+    /// Returns (folded, witnesses redirected, witnesses without a target).
+    pub fn fold(&mut self, n: TyId, hist: &[TyId], bottom: Bot) -> (TyId, u32, u32) {
+        let hist: Vec<TyId> = hist.iter().copied().filter(|&h| self.compound(h)).collect();
+        if hist.is_empty() {
+            return (n, 0, 0);
+        }
+        let len = self.regs[n as usize].nodes.len();
+        let mut guarded = vec![false; len];
+        for d in 1..len {
+            let p = self.regs[n as usize].parent[d] as usize;
+            guarded[d] = guarded[p] || self.regs[n as usize].nodes[p].is_ctor();
+        }
+        let hist_heads: Vec<Vec<ArmHead>> = hist.iter().map(|&h| self.arm_heads(h, 0, 0)).collect();
+        let mask = bottom.mask();
+        let mut redirect: HashMap<u32, u32> = HashMap::new();
+        let mut orphans = 0u32;
+        for d in 1..len as u32 {
+            let node = &self.regs[n as usize].nodes[d as usize];
+            if node.is_leaf() || !guarded[d as usize] {
+                continue;
+            }
+            let dh = self.arm_heads(n, d, 0);
+            let mut witness = false;
+            for (hi, &h) in hist.iter().enumerate() {
+                // rigid cover needs every arm head of h among d's arms
+                if !hist_heads[hi].iter().all(|x| dh.contains(x)) {
+                    continue;
+                }
+                if self.sim(n, d, h, 0, Bot::Rigid) {
+                    witness = true;
+                    break;
+                }
+            }
+            if !witness {
+                continue;
+            }
+            let mut target = None;
+            let dpat = self.arm_heads(n, d, mask);
+            let mut a = self.regs[n as usize].parent[d as usize];
+            // the new back edge a → … → d must pass through a constructor, or the redirect
+            // makes an unguarded union cycle (X = X | …), which collapses to its other arms
+            let mut guarded_path = false;
+            while a != NONE {
+                guarded_path |= self.regs[n as usize].nodes[a as usize].is_ctor();
+                if guarded_path
+                    && !redirect.contains_key(&a)
+                    && self.arm_heads(n, a, mask) == dpat
+                    && self.sim(n, a, n, d, bottom)
+                {
+                    target = Some(a);
+                    break;
+                }
+                a = self.regs[n as usize].parent[a as usize];
+            }
+            match target {
+                Some(t) => {
+                    redirect.insert(d, t);
+                }
+                None => orphans += 1,
+            }
+        }
+        if redirect.is_empty() {
+            return (n, 0, orphans);
+        }
+        let g: Vec<Node> = self.regs[n as usize]
+            .nodes
+            .iter()
+            .map(|node| {
+                node.map(&mut |c| {
+                    let mut s = c;
+                    while let Some(&t) = redirect.get(&s) {
+                        s = t;
+                    }
+                    s
+                })
+            })
+            .collect();
+        let Some(out) = self.canon(g, 0) else { return (n, 0, orphans) };
+        FOLD_CHECKS.with(|c| {
+            let mut c = c.borrow_mut();
+            c.0 += 1;
+        });
+        if !self.sim(out, 0, n, 0, bottom) {
+            FOLD_CHECKS.with(|c| c.borrow_mut().1 += 1);
+            if std::env::var("RH_EP3_T1DUMP").is_ok_and(|v| v == "1") {
+                /* Input-bearing debug probe omitted. */
+            }
+        }
+        (out, redirect.len() as u32, orphans)
+    }
+
+    // ------------------------------------------------------------------ backstop
+
+    fn truncation(&self, id: TyId, i: u32, k: u32, out: &mut String) {
+        let nodes = &self.regs[id as usize].nodes;
+        match &nodes[i as usize] {
+            Node::Leaf(l) => {
+                out.push('L');
+                out.push_str(&l.to_string());
+            }
+            Node::Union(cs) => {
+                let mut parts: Vec<String> = cs
+                    .iter()
+                    .map(|c| {
+                        let mut s = String::new();
+                        self.truncation(id, *c, k, &mut s);
+                        s
+                    })
+                    .collect();
+                parts.sort();
+                parts.dedup();
+                out.push_str("U(");
+                out.push_str(&parts.join(","));
+                out.push(')');
+            }
+            other => {
+                if k == 0 {
+                    out.push('*');
+                    return;
+                }
+                out.push_str(&format!("{:?}(", Self::arm_head(other)));
+                for c in other.kids() {
+                    self.truncation(id, *c, k - 1, out);
+                    out.push(',');
+                }
+                out.push(')');
+            }
+        }
+    }
+
+    /// ARTMC-style backstop: merge all compound states sharing a k-truncation, determinize.
+    /// Sound (adds arms only); bounds the state count. Returns (widened, groups merged).
+    pub fn widen_k(&mut self, n: TyId, k: u32) -> (TyId, u32) {
+        let len = self.regs[n as usize].nodes.len();
+        let mut groups: BTreeMap<String, Vec<u32>> = BTreeMap::new();
+        for i in 0..len as u32 {
+            let node = &self.regs[n as usize].nodes[i as usize];
+            if node.is_leaf() {
+                continue;
+            }
+            let mut s = String::new();
+            self.truncation(n, i, k, &mut s);
+            groups.entry(s).or_default().push(i);
+        }
+        let merged: Vec<Vec<u32>> = groups.into_values().filter(|g| g.len() > 1).collect();
+        if merged.is_empty() {
+            return (n, 0);
+        }
+        let mut g: Vec<Node> = self.regs[n as usize].nodes.to_vec();
+        let mut rep: HashMap<u32, u32> = HashMap::new();
+        for grp in &merged {
+            let u = g.len() as u32;
+            g.push(Node::Union(grp.clone().into_boxed_slice()));
+            for &i in grp {
+                rep.insert(i, u);
+            }
+        }
+        for i in 0..len {
+            let node = g[i].map(&mut |c| *rep.get(&c).unwrap_or(&c));
+            g[i] = node;
+        }
+        let root = *rep.get(&0).unwrap_or(&0);
+        match self.canon(g, root) {
+            Some(out) => (out, merged.len() as u32),
+            None => (n, 0),
+        }
+    }
+
+    /// Constructor depth of an acyclic type (unions don't count); for a cyclic one the depth
+    /// of its DFS spanning tree, which is what the backstop guard needs (it skips cycles).
+    pub fn depth(&mut self, id: TyId) -> u32 {
+        if let Some(&d) = self.depth_memo.get(&id) {
+            return d;
+        }
+        let nodes = &self.regs[id as usize].nodes;
+        let len = nodes.len();
+        let mut memo: Vec<u32> = vec![NONE; len];
+        // reverse DFS order: children have larger numbers in an acyclic DFS numbering? Not
+        // necessarily (shared states), so compute with an explicit post-order.
+        fn go(nodes: &[Node], i: usize, memo: &mut Vec<u32>, onstack: &mut Vec<bool>) -> u32 {
+            if memo[i] != NONE {
+                return memo[i];
+            }
+            if onstack[i] {
+                return 0;
+            }
+            onstack[i] = true;
+            let step = if nodes[i].is_ctor() { 1 } else { 0 };
+            let mut best = 0;
+            for &c in nodes[i].kids() {
+                best = best.max(go(nodes, c as usize, memo, onstack));
+            }
+            onstack[i] = false;
+            memo[i] = step + best;
+            memo[i]
+        }
+        let mut onstack = vec![false; len];
+        let d = go(nodes, 0, &mut memo, &mut onstack);
+        self.depth_memo.insert(id, d);
+        d
+    }
+
+    // ------------------------------------------------------------------ printing
+
+    /// A μ-term: back-edge targets are bound with μ.
+    pub fn show(&self, id: TyId) -> String {
+        let nodes = &self.regs[id as usize].nodes;
+        let mut targets: Vec<u32> = Vec::new();
+        fn scan(nodes: &[Node], i: u32, path: &mut Vec<u32>, targets: &mut Vec<u32>) {
+            if path.contains(&i) {
+                if !targets.contains(&i) {
+                    targets.push(i);
+                }
+                return;
+            }
+            path.push(i);
+            for &c in nodes[i as usize].kids() {
+                scan(nodes, c, path, targets);
+            }
+            path.pop();
+        }
+        scan(nodes, 0, &mut Vec::new(), &mut targets);
+        targets.sort_unstable();
+        let names: HashMap<u32, char> =
+            targets.iter().enumerate().map(|(k, t)| (*t, ['X', 'Y', 'Z', 'V', 'W', 'T'][k % 6])).collect();
+        fn go(this: &Interner, nodes: &[Node], i: u32, path: &mut Vec<u32>, names: &HashMap<u32, char>) -> String {
+            if path.contains(&i) {
+                return names[&i].to_string();
+            }
+            if path.len() > 40 {
+                return "…".into();
+            }
+            path.push(i);
+            let body = match &nodes[i as usize] {
+                Node::Leaf(l) => short_leaf(this.leaf_ty(*l)),
+                Node::Array([c]) => format!("Array[{}]", go(this, nodes, *c, path, names)),
+                Node::Hash([k, v]) => format!("Hash[{}, {}]", go(this, nodes, *k, path, names), go(this, nodes, *v, path, names)),
+                Node::Tuple(cs) => format!("[{}]", cs.iter().map(|c| go(this, nodes, *c, path, names)).collect::<Vec<_>>().join(", ")),
+                Node::Record(s, cs) => {
+                    let (f, _) = &this.shapes[*s as usize];
+                    format!(
+                        "{{{}}}",
+                        f.iter().zip(cs.iter()).map(|(n, c)| format!("{}: {}", n.as_str(), go(this, nodes, *c, path, names))).collect::<Vec<_>>().join(", ")
+                    )
+                }
+                Node::Class(ci, cs) => format!(
+                    "{}[{}]",
+                    this.classes[*ci as usize].0.as_str(),
+                    cs.iter().map(|c| go(this, nodes, *c, path, names)).collect::<Vec<_>>().join(", ")
+                ),
+                Node::Union(cs) => {
+                    let mut parts: Vec<String> = cs.iter().map(|c| go(this, nodes, *c, path, names)).collect();
+                    parts.sort();
+                    let s = parts.join(" | ");
+                    if path.len() > 1 { format!("({s})") } else { s }
+                }
+            };
+            path.pop();
+            match names.get(&i) {
+                Some(n) => format!("μ{n}.({body})"),
+                None => body,
+            }
+        }
+        go(self, nodes, 0, &mut Vec::new(), &names)
+    }
+
+    /// RBS: one alias per back-edge target (the root included), bodies inline otherwise.
+    pub fn show_rbs(&self, id: TyId, name: &str) -> String {
+        let nodes = &self.regs[id as usize].nodes;
+        let mut targets: Vec<u32> = vec![0];
+        fn scan(nodes: &[Node], i: u32, path: &mut Vec<u32>, targets: &mut Vec<u32>) {
+            if path.contains(&i) {
+                if !targets.contains(&i) {
+                    targets.push(i);
+                }
+                return;
+            }
+            path.push(i);
+            for &c in nodes[i as usize].kids() {
+                scan(nodes, c, path, targets);
+            }
+            path.pop();
+        }
+        scan(nodes, 0, &mut Vec::new(), &mut targets);
+        // shared compound states get an alias too, so printing stays linear in the states
+        let mut indeg = vec![0u32; nodes.len()];
+        for n in nodes.iter() {
+            for &c in n.kids() {
+                indeg[c as usize] += 1;
+            }
+        }
+        for (i, n) in nodes.iter().enumerate() {
+            if indeg[i] > 1 && !n.is_leaf() {
+                targets.push(i as u32);
+            }
+        }
+        targets.sort_unstable();
+        targets.dedup();
+        let alias: HashMap<u32, String> = targets
+            .iter()
+            .enumerate()
+            .map(|(k, t)| (*t, if k == 0 { name.to_string() } else { format!("{name}{k}") }))
+            .collect();
+        fn go(this: &Interner, nodes: &[Node], i: u32, top: bool, alias: &HashMap<u32, String>, path: &mut Vec<u32>) -> String {
+            if !top {
+                if let Some(a) = alias.get(&i) {
+                    return a.clone();
+                }
+            }
+            if path.contains(&i) {
+                return "untyped".into();
+            }
+            path.push(i);
+            let s = match &nodes[i as usize] {
+                Node::Leaf(l) => rbs_leaf(this.leaf_ty(*l)),
+                Node::Array([c]) => format!("Array[{}]", go(this, nodes, *c, false, alias, path)),
+                Node::Hash([k, v]) => format!("Hash[{}, {}]", go(this, nodes, *k, false, alias, path), go(this, nodes, *v, false, alias, path)),
+                Node::Tuple(cs) => format!("[{}]", cs.iter().map(|c| go(this, nodes, *c, false, alias, path)).collect::<Vec<_>>().join(", ")),
+                Node::Record(s, cs) => {
+                    let (f, _) = &this.shapes[*s as usize];
+                    format!(
+                        "{{ {} }}",
+                        f.iter().zip(cs.iter()).map(|(n, c)| format!("{}: {}", n.as_str(), go(this, nodes, *c, false, alias, path))).collect::<Vec<_>>().join(", ")
+                    )
+                }
+                Node::Class(ci, cs) => format!(
+                    "{}[{}]",
+                    rbs_class(this.classes[*ci as usize].0.as_str()),
+                    cs.iter().map(|c| go(this, nodes, *c, false, alias, path)).collect::<Vec<_>>().join(", ")
+                ),
+                Node::Union(cs) => {
+                    let mut parts: Vec<String> = cs.iter().map(|c| go(this, nodes, *c, false, alias, path)).collect();
+                    // nil last, as RBS writers do
+                    parts.sort_by_key(|p| (p == "nil", p.clone()));
+                    parts.dedup();
+                    parts.join(" | ")
+                }
+            };
+            path.pop();
+            s
+        }
+        targets
+            .iter()
+            .map(|t| format!("type {} = {}", alias[t], go(self, nodes, *t, true, &alias, &mut Vec::new())))
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+}
+
+fn rbs_class(name: &str) -> String {
+    if name.contains("::") || name.chars().next().is_some_and(|c| c.is_ascii_uppercase()) {
+        format!("::{name}")
+    } else {
+        name.to_string()
+    }
+}
+
+fn short_leaf(t: &Ty) -> String {
+    match t {
+        Ty::Int => "Integer".into(),
+        Ty::Float => "Float".into(),
+        Ty::Bool => "bool".into(),
+        Ty::Str => "String".into(),
+        Ty::Sym => "Symbol".into(),
+        Ty::Nil => "nil".into(),
+        Ty::Untyped => "untyped".into(),
+        Ty::Bottom => "⊥".into(),
+        Ty::Var { var } => format!("Var{}", var.0),
+        Ty::Class { id, .. } => id.0.as_str().to_string(),
+        Ty::Relation { of } => format!("Relation[{}]", of.0.as_str()),
+        other => format!("{other:?}").chars().take(24).collect(),
+    }
+}
+
+fn rbs_leaf(t: &Ty) -> String {
+    match t {
+        Ty::Int => "Integer".into(),
+        Ty::Float => "Float".into(),
+        Ty::Bool => "bool".into(),
+        Ty::Str => "String".into(),
+        Ty::Sym => "Symbol".into(),
+        Ty::Date => "::Date".into(),
+        Ty::Time => "::Time".into(),
+        Ty::Nil => "nil".into(),
+        Ty::Bottom => "bot".into(),
+        Ty::Class { id, .. } => rbs_class(id.0.as_str()),
+        Ty::Relation { of } => format!("::ActiveRecord::Relation[{}]", rbs_class(of.0.as_str())),
+        _ => "untyped".into(),
+    }
+}
+
+fn is_cyclic(nodes: &[Node]) -> bool {
+    // iterative three-colour DFS
+    let n = nodes.len();
+    let mut color = vec![0u8; n];
+    for start in 0..n {
+        if color[start] != 0 {
+            continue;
+        }
+        let mut stack: Vec<(usize, usize)> = vec![(start, 0)];
+        color[start] = 1;
+        while let Some(&mut (s, ref mut next)) = stack.last_mut() {
+            let ks = nodes[s].kids();
+            if *next >= ks.len() {
+                color[s] = 2;
+                stack.pop();
+                continue;
+            }
+            let c = ks[*next] as usize;
+            *next += 1;
+            match color[c] {
+                1 => return true,
+                0 => {
+                    color[c] = 1;
+                    stack.push((c, 0));
+                }
+                _ => {}
+            }
+        }
+    }
+    false
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Bot {
+    /// leaves (⊥ included) match only themselves
+    Rigid,
+    /// ⊥ and `Var` (Roundhouse's "not computed yet") in the covered side sit below
+    /// everything; with `untyped`, so does `Untyped`
+    Bottom { untyped: bool },
+    /// an explicit leaf-class mask (1 = ⊥, 2 = `Var`, 4 = `Untyped`); the model's tests use ⊥ only
+    #[allow(dead_code)]
+    Mask(u8),
+}
+
+impl Bot {
+    fn mask(self) -> u8 {
+        match self {
+            Bot::Rigid => 0,
+            Bot::Bottom { untyped } => 1 | 2 | if untyped { 4 } else { 0 },
+            Bot::Mask(m) => m,
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn sim_go(a: &[Node], b: &[Node], p: u32, q: u32, mask: u8, lc: &[u8], visited: &mut HashSet<(u32, u32)>) -> bool {
+    if !visited.insert((p, q)) {
+        return true;
+    }
+    let nq = &b[q as usize];
+    if let Node::Leaf(l) = nq {
+        if lc[*l as usize] & mask != 0 {
+            return true;
+        }
+    }
+    if let Node::Union(arms) = nq {
+        for &c in arms.iter() {
+            if !sim_go(a, b, p, c, mask, lc, visited) {
+                return false;
+            }
+        }
+        return true;
+    }
+    let np = &a[p as usize];
+    let parms: Vec<u32> = match np {
+        Node::Union(x) => x.to_vec(),
+        _ => vec![p],
+    };
+    match nq {
+        Node::Leaf(l) => parms.iter().any(|&r| matches!(&a[r as usize], Node::Leaf(x) if x == l)),
+        Node::Array([c]) => match parms.iter().find(|&&r| matches!(a[r as usize], Node::Array(_))) {
+            Some(&r) => {
+                let Node::Array([ac]) = a[r as usize] else { unreachable!() };
+                sim_go(a, b, ac, *c, mask, lc, visited)
+            }
+            None => false,
+        },
+        Node::Hash([k, v]) => match parms.iter().find(|&&r| matches!(a[r as usize], Node::Hash(_))) {
+            Some(&r) => {
+                let Node::Hash([ak, av]) = a[r as usize] else { unreachable!() };
+                sim_go(a, b, ak, *k, mask, lc, visited) && sim_go(a, b, av, *v, mask, lc, visited)
+            }
+            None => false,
+        },
+        other => {
+            let want = Interner::arm_head(other);
+            let qk = other.kids();
+            for &r in &parms {
+                let ar = &a[r as usize];
+                if ar.is_union() || ar.is_leaf() || Interner::arm_head(ar) != want {
+                    continue;
+                }
+                let snap = visited.clone();
+                let ak = ar.kids().to_vec();
+                if ak.iter().zip(qk.iter()).all(|(x, y)| sim_go(a, b, *x, *y, mask, lc, visited)) {
+                    return true;
+                }
+                *visited = snap;
+            }
+            false
+        }
+    }
+}
