 /// Single merge decision for an existing harvested return vs a new body type.
 fn decide_harvested_return(existing: &Ty, new: Ty) -> HarvestWrite {
+    decide_harvested_return_with(existing, new, true)
+}
+
+/// `untie = false` is EP3's decision: the fold at the side table replaces the occurs check.
+fn decide_harvested_return_with(existing: &Ty, new: Ty, untie: bool) -> HarvestWrite {
     if matches!(existing, Ty::Fn { .. }) {
         return HarvestWrite::Keep;
     }
     if existing == &new {
         return HarvestWrite::Keep;
     }
-    if let Some(untied) = untie_recursive_return(existing, &new) {
+    if untie && let Some(untied) = untie_recursive_return(existing, &new) {
         if existing == &untied {
             return HarvestWrite::Keep;
         }
@@ -166,6 +171,27 @@ pub(super) fn insert_inferred_return(
     }
 }
 
+/// EP3 (`RH_EP3`): main's merge decision without `untie`, then the side table's store step,
+/// whose answer (the typed value, or `view_1` of a folded entry) is what the typer reads.
+pub(super) fn insert_inferred_return_ep3(
+    table: &mut std::collections::HashMap<Symbol, Ty>,
+    method: &Symbol,
+    ty: Ty,
+    key: super::ep3::SlotKey,
+) {
+    let set = match table.get(method) {
+        None => Some(ty),
+        Some(existing) => match decide_harvested_return_with(existing, ty, false) {
+            HarvestWrite::Keep => None,
+            HarvestWrite::Set(next) => Some(next),
+        },
+    };
+    if let Some(next) = set {
+        let shown = super::ep3::store(key, &next);
+        table.insert(method.clone(), shown);
+    }
+}
