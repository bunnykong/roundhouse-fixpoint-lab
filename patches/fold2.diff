+/// Run `f` with head matching on (prototype fold).
+pub(super) fn with_head_match<T>(on: bool, f: impl FnOnce() -> T) -> T {
+    if !on {
+        return f();
+    }
+    let prev = HEAD_MATCH.with(|h| h.replace(true));
+    let out = f();
+    HEAD_MATCH.with(|h| h.set(prev));
+    out
