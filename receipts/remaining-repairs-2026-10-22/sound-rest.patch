+                elements: vec![mapped_value.clone(), mapped_value],
+                style: Default::default(),
+            }),
+        }));
+        let mut sites = vec![];
+        sidekiq_sites(&mapped, &owner, SiteRecv::Class, &kw, &classes, &mut sites);
+        assert_eq!(
+            sites[0].2,
+            vec![Ty::Int, Ty::Int],
